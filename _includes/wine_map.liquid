{% comment %}
  Interactive wine map for /le-mie-passioni/.
  Data source: _data/wines.yml (populated by bin/sync-wines from the tasting form).
  Requires `map: true` in the host page's front matter so al-folio loads Leaflet
  (CSS via _includes/head.liquid, JS via _includes/scripts/leaflet.liquid).

  The card is authored in Italian; the EN toggle translates the wine content at
  runtime through Google Translate's free endpoint and caches it in localStorage.
{% endcomment %}

<style>
  #wine-map {
    height: clamp(340px, 60vh, 560px);
    width: 100%;
    border-radius: 8px;
    z-index: 0;
  }
  @media (max-width: 576px) {
    #wine-map {
      height: clamp(300px, 52vh, 420px);
    }
  }
  #wine-map .leaflet-container {
    background: var(--global-bg-color);
    font: inherit;
  }
  /* OpenStreetMap has no dark tiles: dim them so the map follows the site theme. */
  html[data-theme="dark"] #wine-map .leaflet-tile {
    filter: invert(1) hue-rotate(180deg) brightness(0.92) contrast(0.95);
  }
  html[data-theme="dark"] #wine-map .leaflet-container {
    background: #1c1c1d;
  }

  .wine-marker {
    background: none;
    border: none;
  }
  .wine-marker svg {
    display: block;
    filter: drop-shadow(0 2px 2.5px rgba(0, 0, 0, 0.55));
  }
  html[data-theme="dark"] .wine-marker svg {
    filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.8));
  }

  .leaflet-popup.wine-popup .leaflet-popup-content-wrapper,
  .leaflet-popup.wine-popup .leaflet-popup-tip {
    background: var(--global-bg-color);
    color: var(--global-text-color);
  }
  .leaflet-popup.wine-popup .leaflet-popup-content-wrapper {
    border-radius: 6px;
  }
  .leaflet-popup.wine-popup .leaflet-popup-content {
    margin: 0.7rem 0.9rem;
    line-height: 1.45;
  }
  .wine-popup .wine-card {
    width: 232px;
  }

  .wine-card .wine-name {
    font-weight: 600;
    font-size: 0.98rem;
  }
  .wine-card .wine-vintage {
    color: var(--global-text-color-light);
    font-weight: 400;
  }
  .wine-card .wine-stars {
    display: block;
    margin: 0.2rem 0 0.35rem;
    color: #c8a951;
    letter-spacing: 0.06em;
  }
  .wine-card .wine-stars .empty {
    opacity: 0.5;
  }
  .wine-card .wine-producer a {
    color: var(--global-theme-color);
  }
  .wine-card .wine-site,
  .wine-modal-head .wine-site {
    display: inline-block;
    margin-top: 0.1rem;
    font-size: 0.78rem;
    color: var(--global-theme-color);
    word-break: break-all;
  }
  .wine-card .wine-meta {
    margin-top: 0.15rem;
    font-size: 0.82rem;
    color: var(--global-text-color-light);
  }
  .wine-card .wine-notes {
    margin: 0.4rem 0 0;
    font-size: 0.86rem;
  }
  .wine-card .wine-tasted {
    margin-top: 0.35rem;
    font-size: 0.76rem;
    color: var(--global-text-color-light);
  }
  .wine-card .wine-more {
    margin-top: 0.55rem;
    font: inherit;
    font-size: 0.78rem;
    padding: 0.22rem 0.6rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 4px;
    background: transparent;
    color: var(--global-theme-color);
    cursor: pointer;
  }
  .wine-card .wine-more:hover {
    border-color: var(--global-theme-color);
  }

  /* Full tasting sheet — shown in a modal over the page, not inside the map. */
  .wine-modal-backdrop {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    background: rgba(0, 0, 0, 0.55);
    z-index: 2000;
    animation: wine-modal-fade 0.12s ease-out;
  }
  @keyframes wine-modal-fade {
    from {
      opacity: 0;
    }
  }
  .wine-modal {
    position: relative;
    max-width: min(560px, 92vw);
    max-height: 85vh;
    overflow-y: auto;
    padding: 1.4rem 1.5rem 1.6rem;
    background: var(--global-bg-color);
    color: var(--global-text-color);
    border: 1px solid var(--global-divider-color);
    border-radius: 8px;
    box-shadow: 0 12px 44px rgba(0, 0, 0, 0.35);
  }
  .wine-modal-close {
    position: absolute;
    top: 0.4rem;
    right: 0.55rem;
    padding: 0.2rem 0.45rem;
    font: inherit;
    font-size: 1.45rem;
    line-height: 1;
    background: transparent;
    border: none;
    color: var(--global-text-color-light);
    cursor: pointer;
  }
  .wine-modal-close:hover {
    color: var(--global-theme-color);
  }
  .wine-modal-head {
    margin-right: 1.6rem;
  }
  .wine-modal-head .wine-name {
    font-weight: 600;
    font-size: 1.05rem;
  }
  .wine-modal-head .wine-vintage {
    color: var(--global-text-color-light);
    font-weight: 400;
  }
  .wine-modal-head .wine-stars {
    display: block;
    margin: 0.3rem 0 0.1rem;
    color: #c8a951;
    letter-spacing: 0.06em;
  }
  .wine-modal-head .wine-stars .empty {
    opacity: 0.5;
  }
  .wine-modal-head .wine-producer a {
    color: var(--global-theme-color);
  }
  .wine-modal-head .wine-meta {
    margin-top: 0.15rem;
    font-size: 0.85rem;
    color: var(--global-text-color-light);
  }
  .wine-modal .wine-full {
    margin-top: 0.85rem;
    border-top: 1px solid var(--global-divider-color);
    padding-top: 0.4rem;
  }
  .wine-modal .wine-full .r span:first-child {
    flex-basis: 10rem;
  }
  .wine-full h4 {
    margin: 0.7rem 0 0.2rem;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--global-text-color-light);
  }
  .wine-full .r {
    display: flex;
    gap: 0.4rem;
    font-size: 0.82rem;
    margin: 0.12rem 0;
  }
  .wine-full .r span:first-child {
    flex: 0 0 8.5rem;
    color: var(--global-text-color-light);
  }
  .wine-full .chips-label {
    margin-top: 0.5rem;
    font-size: 0.82rem;
    color: var(--global-text-color-light);
  }
  .wine-full .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin: 0.25rem 0 0.1rem;
  }
  .wine-full .chips span {
    font-size: 0.73rem;
    padding: 0.06rem 0.42rem;
    border-radius: 10px;
    background: var(--global-code-bg-color);
  }
</style>

<div id="wine-map" role="region" aria-label="Map of tasted wines"></div>

<script>
  window.WINE_MAP_DATA = {{ site.data.wines | jsonify | replace: '</', '<\/' }};
</script>

<script>
  (function () {
    function ready(fn) {
      if (document.readyState === "complete") fn();
      else window.addEventListener("load", fn);
    }

    ready(function () {
      var el = document.getElementById("wine-map");
      if (!el) return;
      if (typeof L === "undefined") {
        el.innerHTML =
          '<p style="padding:1rem;margin:0">Map unavailable &mdash; Leaflet did not load. Add <code>map: true</code> to this page\'s front matter.</p>';
        return;
      }

      var wines = Array.isArray(window.WINE_MAP_DATA) ? window.WINE_MAP_DATA : [];

      var COLORS = {
        red: "#FF4D00",
        white: "#E4D96F",
        "rosé": "#df5c86",
        rose: "#df5c86",
        sparkling: "#93973a",
        orange: "#cd6620",
      };

      // Language + IT->EN translation are shared with the finder via window.WineI18n
      // (wine_i18n.liquid, included first). Everything here is authored in Italian.
      var I18N = window.WineI18n || {
        lang: "it",
        translate: function (el, done) {
          if (done) done();
        },
        onChange: function () {},
      };

      function esc(s) {
        return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
          return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
        });
      }
      function blankStr(v) {
        return v == null || String(v).trim() === "";
      }
      function safeUrl(u) {
        u = String(u || "").trim();
        if (!u) return "";
        if (/^(https?:\/\/|\/)/i.test(u)) return u;
        // the form's "Url" field is optional and often typed without a scheme
        if (/^[\w-]+(\.[\w-]+)+([/?#]|$)/.test(u)) return "https://" + u;
        return "";
      }
      function hostOf(u) {
        try {
          return new URL(u).hostname.replace(/^www\./, "");
        } catch (e) {
          return String(u || "").replace(/^https?:\/\//i, "").split("/")[0];
        }
      }

      function translateEl(rootEl, done) {
        I18N.translate(rootEl, done);
      }

      function bottleIcon(color) {
        var fill = COLORS[color] || "#6b6b6b";
        var d =
          "M9.5 2h5v2.3c0 .95.4 1.4 1 2.15C16.4 7.7 17 9 17 10.6V21c0 .55-.45 1-1 1H8c-.55 0-1-.45-1-1V10.6c0-1.6.6-2.9 1.5-4.15.6-.75 1-1.2 1-2.15V2z";
        var svg =
          '<svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true">' +
          '<path d="' + d + '" fill="' + fill + '" stroke="#ffffff" stroke-width="3" stroke-linejoin="round" paint-order="stroke"/>' +
          '<path d="' + d + '" fill="none" stroke="rgba(0,0,0,0.6)" stroke-width="1" stroke-linejoin="round"/>' +
          "</svg>";
        return L.divIcon({
          html: svg,
          className: "wine-marker",
          iconSize: [30, 30],
          iconAnchor: [15, 29],
          popupAnchor: [0, -26],
        });
      }

      function stars(r) {
        r = Math.max(0, Math.min(5, Number(r) || 0));
        var full = Math.floor(r);
        var half = r - full >= 0.5;
        var out = "";
        var i;
        for (i = 0; i < full; i++) out += '<i class="fa-solid fa-star"></i>';
        if (half) out += '<i class="fa-solid fa-star-half-stroke"></i>';
        for (i = full + (half ? 1 : 0); i < 5; i++) out += '<i class="fa-regular fa-star empty"></i>';
        return '<span class="wine-stars no-tx" aria-label="' + r + ' / 5">' + out + "</span>";
      }

      function chips(arr) {
        return (
          '<div class="chips">' +
          arr
            .filter(Boolean)
            .map(function (a) {
              return "<span>" + esc(a) + "</span>";
            })
            .join("") +
          "</div>"
        );
      }

      // section -> [key, Italian heading, scalar [field,label] in order,
      //             chip [field,label], free-text [field,label]]. Labels match the
      //             tasting form's own wording so nothing is lost to abbreviation.
      var SECTIONS = [
        [
          "visual",
          "Esame visivo",
          [
            ["limpidezza", "Limpidezza"],
            ["intensita_colore", "Intensità del colore"],
            ["colore", "Colore"],
            ["metodo", "Metodo di produzione"],
            ["effervescenza", "Effervescenza — intensità"],
            ["perlage_dimensione", "Perlage — dimensione delle bollicine"],
            ["perlage_persistenza", "Perlage — persistenza"],
          ],
          [["osservazioni", "Altre osservazioni visive"]],
          [],
        ],
        [
          "nose",
          "Esame olfattivo",
          [
            ["condizione", "Condizione dei sentori"],
            ["intensita", "Intensità olfattiva"],
            ["evoluzione", "Evoluzione olfattiva"],
          ],
          [["aromi", "Aromi percepiti"]],
          [["altri_aromi", "Altri aromi / note"]],
        ],
        [
          "palate",
          "Esame gustativo",
          [
            ["zucchero", "Zucchero (dolcezza)"],
            ["acidita", "Acidità"],
            ["tannini", "Tannini"],
            ["alcol", "Alcol"],
            ["corpo", "Corpo"],
            ["intensita_sapori", "Intensità dei sapori"],
            ["finale", "Persistenza"],
          ],
          [["aromi_palato", "Aromi al palato (per fase)"]],
          [],
        ],
      ];

      function sectionHtml(obj, spec) {
        if (!obj) return "";
        var rows = spec[2]
          .filter(function (f) {
            return !blankStr(obj[f[0]]);
          })
          .map(function (f) {
            return '<div class="r"><span>' + esc(f[1]) + "</span><span>" + esc(obj[f[0]]) + "</span></div>";
          })
          .join("");
        var chipHtml = spec[3]
          .map(function (f) {
            if (!Array.isArray(obj[f[0]]) || !obj[f[0]].length) return "";
            var lbl = f[1] ? '<div class="chips-label">' + esc(f[1]) + "</div>" : "";
            return lbl + chips(obj[f[0]]);
          })
          .join("");
        var freeHtml = spec[4]
          .map(function (f) {
            return blankStr(obj[f[0]])
              ? ""
              : '<div class="r"><span>' + esc(f[1]) + "</span><span>" + esc(obj[f[0]]) + "</span></div>";
          })
          .join("");
        if (!rows && !chipHtml && !freeHtml) return "";
        return "<h4>" + esc(spec[1]) + "</h4>" + rows + chipHtml + freeHtml;
      }

      function fullView(w) {
        var tv = w.tasting;
        if (!tv || typeof tv !== "object") return "";
        var body = SECTIONS.map(function (spec) {
          return sectionHtml(tv[spec[0]], spec);
        }).join("");
        return body ? '<div class="wine-full">' + body + "</div>" : "";
      }
      function hasFull(w) {
        return fullView(w) !== "";
      }

      // Wine identity block, shared by the popup summary and the modal header.
      function identHtml(w) {
        var url = safeUrl(w.url);
        var vintage = w.vintage ? ' <span class="wine-vintage">' + esc(w.vintage) + "</span>" : "";
        var meta = [w.denominazione, w.region, w.country, w.grape].filter(Boolean).map(esc).join(" &middot; ");
        var site = url
          ? '<a class="wine-site no-tx" href="' + esc(url) + '" target="_blank" rel="noopener noreferrer">' +
            esc(hostOf(url)) + " ↗</a>"
          : "";
        return (
          '<div class="wine-name no-tx">' + esc(w.name) + vintage + "</div>" +
          stars(w.rating) +
          '<div class="wine-producer no-tx">' + esc(w.producer) + "</div>" +
          site +
          (meta ? '<div class="wine-meta">' + meta + "</div>" : "")
        );
      }

      function cardHtml(w) {
        var price = w.price ? '<div class="wine-meta no-tx">' + esc(w.price) + "</div>" : "";
        var notes = blankStr(w.notes) ? "" : '<p class="wine-notes">' + esc(w.notes) + "</p>";
        var pairing = blankStr(w.pairing)
          ? ""
          : '<div class="wine-meta"><i class="fa-solid fa-utensils"></i> Abbinamento: ' + esc(w.pairing) + "</div>";
        var tasted = w.tasted
          ? '<div class="wine-tasted">Degustato il <span class="no-tx">' + esc(w.tasted) + "</span></div>"
          : "";
        var more = hasFull(w)
          ? '<button type="button" class="wine-more">Vedi valutazione completa</button>'
          : "";
        return (
          '<div class="wine-card">' +
          identHtml(w) +
          price +
          notes +
          pairing +
          tasted +
          more +
          "</div>"
        );
      }

      // Popup content is a DOM node (not a string) so Leaflet's popup.update() re-appends
      // the same element and keeps the in-place translation instead of re-rendering it.
      function cardNode(w) {
        var tpl = document.createElement("template");
        tpl.innerHTML = cardHtml(w).trim();
        return tpl.content.firstElementChild || tpl.firstElementChild;
      }

      var map = L.map(el, { scrollWheelZoom: false, worldCopyJump: true });
      map.on("click", function () {
        map.scrollWheelZoom.enable();
      });
      map.on("mouseout", function () {
        map.scrollWheelZoom.disable();
      });

      L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        maxZoom: 19,
      }).addTo(map);

      var openPopup = null;

      // ---- full tasting sheet in a modal over the page (not clipped by the map) ----
      var modalEl = null;
      var modalReturnFocus = null;

      function closeModal() {
        if (!modalEl) return;
        document.removeEventListener("keydown", onModalKey);
        modalEl.remove();
        modalEl = null;
        document.body.style.overflow = "";
        if (modalReturnFocus && modalReturnFocus.focus) modalReturnFocus.focus();
        modalReturnFocus = null;
      }
      function onModalKey(e) {
        if (e.key === "Escape" || e.keyCode === 27) closeModal();
      }
      function openModal(w) {
        closeModal();
        modalReturnFocus = document.activeElement;

        var back = document.createElement("div");
        back.className = "wine-modal-backdrop";
        back.addEventListener("click", function (e) {
          if (e.target === back) closeModal();
        });

        var box = document.createElement("div");
        box.className = "wine-modal";
        box.setAttribute("role", "dialog");
        box.setAttribute("aria-modal", "true");
        box.setAttribute("aria-label", (w.name || "") + (w.vintage ? " " + w.vintage : ""));
        box.innerHTML =
          '<button type="button" class="wine-modal-close no-tx" aria-label="Chiudi">&times;</button>' +
          '<div class="wine-modal-head">' +
          identHtml(w) +
          "</div>" +
          fullView(w);
        box.querySelector(".wine-modal-close").addEventListener("click", closeModal);

        back.appendChild(box);
        document.body.appendChild(back);
        modalEl = back;
        document.body.style.overflow = "hidden";
        document.addEventListener("keydown", onModalKey);
        box.querySelector(".wine-modal-close").focus();

        translateEl(box);
      }

      function wireMore(popup) {
        var root = popup.getElement ? popup.getElement() : popup._container;
        if (!root) return;
        var btn = root.querySelector(".wine-more");
        if (!btn) return;
        var w = popup._source && popup._source._wine;
        btn.onclick = function () {
          if (w) openModal(w);
        };
      }

      function refreshOpenPopup(onDone) {
        if (!openPopup) {
          if (onDone) onDone();
          return;
        }
        wireMore(openPopup);
        var root = openPopup.getElement && openPopup.getElement();
        translateEl(root && root.querySelector(".wine-card"), function () {
          openPopup.update();
          if (onDone) onDone();
        });
      }

      map.on("popupopen", function (e) {
        openPopup = e.popup;
        refreshOpenPopup();
      });
      map.on("popupclose", function () {
        openPopup = null;
      });

      // ---- language: driven by the single section toggle (window.WineI18n) ----
      I18N.onChange(function () {
        closeModal(); // it was rendered in the old language
        markers.forEach(function (m) {
          m.setPopupContent(cardNode(m._wine)); // rebuild from the Italian source
        });
        refreshOpenPopup();
      });

      // Fan out markers that share the exact same coordinates so each stays clickable.
      var seen = {};
      var pts = [];
      var markers = [];
      wines.forEach(function (w) {
        var lat = Number(w.lat);
        var lng = Number(w.lng);
        if (!isFinite(lat) || !isFinite(lng)) return;
        var key = lat.toFixed(5) + "," + lng.toFixed(5);
        var n = seen[key] || 0;
        seen[key] = n + 1;
        if (n > 0) {
          var ang = n * 2.399963; // golden angle
          var rad = 0.00018 * Math.ceil(n / 6); // ~20 m rings
          lat += rad * Math.cos(ang);
          lng += (rad * Math.sin(ang)) / Math.cos((lat * Math.PI) / 180);
        }
        var m = L.marker([lat, lng], {
          icon: bottleIcon(w.color),
          title: (w.name || "") + (w.producer ? " — " + w.producer : ""),
        })
          .addTo(map)
          .bindPopup(cardNode(w), { className: "wine-popup", maxWidth: 340, minWidth: 200 });
        m._wine = w;
        markers.push(m);
        pts.push([lat, lng]);
      });

      if (pts.length) {
        map.fitBounds(pts, { padding: [30, 30], maxZoom: 8 });
      } else {
        map.setView([46, 6], 4);
      }

      // The finder (wine_finder.liquid) asks the map to focus one wine.
      window.addEventListener("winefinder:show", function (ev) {
        var d = (ev && ev.detail) || {};
        var hit = markers.filter(function (m) {
          return m._wine && m._wine.name === d.name && m._wine.producer === d.producer;
        })[0];
        if (!hit) return;
        map.setView(hit.getLatLng(), Math.max(map.getZoom(), 7), { animate: true });
        hit.openPopup();
        el.scrollIntoView({ behavior: "smooth", block: "center" });
      });

      // ...or to open a wine's full tasting sheet.
      window.addEventListener("winefinder:sheet", function (ev) {
        var d = (ev && ev.detail) || {};
        var w = wines.filter(function (x) {
          return x.name === d.name && x.producer === d.producer;
        })[0];
        if (w) openModal(w);
      });

      // Legend under the map — labels + colours straight from COLORS, present types only.
      (function () {
        var host = document.getElementById("wine-legend");
        if (!host) return;
        var LABEL = { red: "Rosso", white: "Bianco", "rosé": "Rosé", sparkling: "Bollicine", orange: "Arancione" };
        var order = ["red", "white", "rosé", "sparkling", "orange"];
        var present = {};
        wines.forEach(function (w) {
          var c = String(w.color || "").toLowerCase();
          if (c === "rose") c = "rosé";
          if (LABEL[c]) present[c] = true;
        });
        var html = order
          .filter(function (c) { return present[c]; })
          .map(function (c) {
            return (
              '<li><span class="wine-legend-dot" style="background:' + COLORS[c] + '"></span>' +
              LABEL[c] +
              "</li>"
            );
          })
          .join("");
        if (html) {
          host.innerHTML = html;
          if (I18N.lang === "en") I18N.translate(host);
        } else {
          host.hidden = true;
        }
      })();
    });
  })();
</script>
