{% comment %}
  Race finder for /le-mie-passioni/ — the "plan a season" interaction in the Correndo
  section, above the map (race_map.liquid). Language is shared with the map via
  window.WineI18n (wine_i18n.liquid, included once at the top of the page).

  Unlike wine_finder.liquid's "one recommendation" framing, this is primarily a browse
  tool: with no free-text query, it's a sortable, soonest-first list of every race that
  passes the active filters — the actual season-planning view. Typing a query and
  pressing "Cerca" switches to a single best-match card + up to 2 runner-ups, same
  shape as the wine finder's recommendation, for the "find me a specific race" ask.

  Data comes from _data/races.yml, auto-compiled by bin/sync-races — see that file's
  header and bin/races-sync.md. Missing distance/elevation/difficulty/price never
  excludes a race from a search; those fields are best-effort by design.
{% endcomment %}

<style>
  #race-finder {
    margin-top: 1.4rem;
  }
  #race-finder .rf-empty {
    font-size: 0.92rem;
    color: var(--global-text-color-light);
  }

  /* ---- primary input ---- */
  .rf-hero {
    margin-bottom: 0.8rem;
  }
  .rf-hero-label {
    display: block;
    margin-bottom: 0.35rem;
    font-size: 1rem;
    font-weight: 500;
  }
  .rf-hero-row {
    display: flex;
    gap: 0.5rem;
  }
  #race-finder input[type="search"] {
    flex: 1 1 auto;
    min-width: 0;
    font: inherit;
    font-size: 0.95rem;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 6px;
    background: var(--global-bg-color);
    color: var(--global-text-color);
  }
  #race-finder button#rf-go {
    flex: 0 0 auto;
    font: inherit;
    font-size: 0.88rem;
    padding: 0 1.1rem;
    border: none;
    border-radius: 6px;
    background: var(--global-theme-color);
    color: #fff;
    cursor: pointer;
  }

  /* ---- filters ---- */
  .rf-quick {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .rf-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .rf-chip {
    font: inherit;
    font-size: 0.8rem;
    line-height: 1;
    padding: 0.36rem 0.65rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 999px;
    background: transparent;
    color: var(--global-text-color);
    cursor: pointer;
  }
  .rf-chip[aria-pressed="true"] {
    background: var(--global-theme-color);
    border-color: var(--global-theme-color);
    color: #fff;
  }
  #race-finder select {
    font: inherit;
    font-size: 0.85rem;
    padding: 0.36rem 0.5rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 6px;
    background: var(--global-bg-color);
    color: var(--global-text-color);
  }
  .rf-range {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.82rem;
    color: var(--global-text-color-light);
  }
  #race-finder input[type="number"] {
    font: inherit;
    font-size: 0.85rem;
    width: 4.2rem;
    padding: 0.36rem 0.4rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 6px;
    background: var(--global-bg-color);
    color: var(--global-text-color);
    -moz-appearance: textfield;
    appearance: textfield;
  }
  #race-finder input[type="number"]::-webkit-outer-spin-button,
  #race-finder input[type="number"]::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  #race-finder input[type="date"] {
    font: inherit;
    font-size: 0.82rem;
    padding: 0.3rem 0.4rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 6px;
    background: var(--global-bg-color);
    color: var(--global-text-color);
  }
  #race-finder button.rf-ghost {
    font: inherit;
    font-size: 0.82rem;
    padding: 0.36rem 0.7rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 6px;
    background: transparent;
    color: var(--global-text-color-light);
    cursor: pointer;
  }
  .rf-more {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.6rem;
    margin: 0.3rem 0 0.6rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 8px;
  }
  .rf-facet {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .rf-label {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--global-text-color-light);
  }

  /* ---- results ---- */
  .rf-results {
    margin-top: 0.6rem;
  }
  .rf-h {
    margin: 1.1rem 0 0.5rem;
    font-size: 0.98rem;
    font-weight: 500;
  }
  .rf-h:first-child {
    margin-top: 0.4rem;
  }
  .rf-badge {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    color: #fff;
    background: #6b6b6b;
  }
  /* One hue per activity, shared with race_map.liquid's marker colors (COLORS there) so
     a badge and its pin always read as the same category at a glance. */
  .rf-badge-road { background: #3d6fb4; }
  .rf-badge-trail { background: #4f8a3d; }
  .rf-badge-skyrun { background: #8659c9; }
  .rf-badge-ultra { background: #c0392b; }
  .rf-badge-triathlon { background: #1f9e9e; }

  /* browse table */
  .rf-table-wrap {
    overflow-x: auto;
  }
  table.rf-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.86rem;
  }
  table.rf-table th {
    text-align: left;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--global-text-color-light);
    padding: 0.3rem 0.6rem;
    border-bottom: 1px solid var(--global-divider-color);
    white-space: nowrap;
  }
  table.rf-table td {
    padding: 0.45rem 0.6rem;
    border-bottom: 1px solid var(--global-divider-color);
    vertical-align: top;
  }
  table.rf-table tr:last-child td {
    border-bottom: none;
  }
  .rf-race-name {
    font-weight: 600;
  }
  .rf-race-meta {
    font-size: 0.78rem;
    color: var(--global-text-color-light);
  }
  .rf-table a.rf-link {
    color: var(--global-theme-color);
  }
  .rf-table button.rf-map-btn {
    font: inherit;
    font-size: inherit;
    padding: 0;
    border: none;
    background: none;
    color: var(--global-theme-color);
    cursor: pointer;
  }
  .rf-show-more {
    margin-top: 0.6rem;
    font: inherit;
    font-size: 0.82rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 6px;
    background: transparent;
    color: var(--global-theme-color);
    cursor: pointer;
  }

  /* query-mode cards, mirroring the wine finder's pick + runner-ups */
  .rf-primary {
    border: 1px solid var(--global-divider-color);
    border-left: 3px solid var(--global-theme-color);
    border-radius: 8px;
    padding: 1rem 1.1rem 1.1rem;
    background: var(--global-card-bg-color);
  }
  .rf-primary-name {
    font-weight: 600;
    font-size: 1.2rem;
    margin-top: 0.5rem;
  }
  .rf-reason {
    margin: 0.6rem 0 0;
    font-size: 0.94rem;
  }
  .rf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.8rem;
  }
  .rf-primary .rf-show {
    font: inherit;
    font-size: 0.82rem;
    padding: 0.4rem 0.85rem;
    border: none;
    border-radius: 6px;
    background: var(--global-theme-color);
    color: #fff;
    cursor: pointer;
  }
  .rf-primary .rf-link-btn {
    font: inherit;
    font-size: 0.82rem;
    padding: 0.38rem 0.85rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 6px;
    background: transparent;
    color: var(--global-text-color);
    text-decoration: none;
  }
  .rf-primary .rf-link-btn:hover {
    border-color: var(--global-theme-color);
    color: var(--global-theme-color);
  }
  @media (max-width: 576px) {
    .rf-hero-row {
      flex-direction: column;
    }
    #race-finder button#rf-go {
      padding: 0.55rem 1rem;
    }
    table.rf-table .rf-col-region {
      display: none;
    }
  }
</style>

<div id="race-finder" hidden>
  <div class="rf-hero">
    <label class="rf-hero-label" for="rf-q">Cerchi una gara in particolare?</label>
    <form id="rf-form" class="rf-hero-row">
      <input
        type="search"
        id="rf-q"
        autocomplete="off"
        placeholder="ultra in montagna, maratona a marzo, triathlon in Svizzera…"
      />
      <button type="submit" id="rf-go">Cerca</button>
    </form>
  </div>

  <div class="rf-quick">
    <div class="rf-chips" id="rf-category-quick">
      <button type="button" class="rf-chip" data-category="road">Strada</button>
      <button type="button" class="rf-chip" data-category="trail">Trail</button>
      <button type="button" class="rf-chip" data-category="skyrun">Skyrun</button>
      <button type="button" class="rf-chip" data-category="ultra">Ultra</button>
      <button type="button" class="rf-chip" data-category="triathlon">Triathlon</button>
    </div>
    <select id="rf-country" aria-label="Paese"><option value="">Paese</option></select>
    <select id="rf-region" aria-label="Regione" hidden><option value="">Regione</option></select>
    <button type="button" id="rf-wine-toggle" class="rf-chip" aria-pressed="false" title="Gare che si abbinano a una zona o evento enologico">🍷 Vino</button>
    <button type="button" id="rf-more-toggle" class="rf-ghost" aria-expanded="false" aria-controls="rf-more">Altri filtri</button>
    <button type="button" id="rf-clear" class="rf-ghost">Pulisci</button>
  </div>

  <div id="rf-more" class="rf-more" hidden>
    <div class="rf-facet">
      <span class="rf-label">Distanza (km)</span>
      <span class="rf-range">
        <input type="number" id="rf-dist-min" min="0" step="1" aria-label="Distanza minima" />
        –
        <input type="number" id="rf-dist-max" min="0" step="1" aria-label="Distanza massima" />
      </span>
    </div>
    <div class="rf-facet" id="rf-elev-wrap" hidden>
      <span class="rf-label">Dislivello (m D+)</span>
      <span class="rf-range">
        <input type="number" id="rf-elev-min" min="0" step="100" aria-label="Dislivello minimo" />
        –
        <input type="number" id="rf-elev-max" min="0" step="100" aria-label="Dislivello massimo" />
      </span>
    </div>
    <div class="rf-facet">
      <span class="rf-label">Periodo</span>
      <span class="rf-range">
        <input type="date" id="rf-date-min" aria-label="Dal" />
        –
        <input type="date" id="rf-date-max" aria-label="Al" />
      </span>
    </div>
  </div>

  <div id="rf-results" class="rf-results" aria-live="polite"></div>
</div>

<script>
  window.RACE_FINDER_DATA = {{ site.data.races | jsonify | replace: '</', '<\/' }};
</script>

<script>
  (function () {
    function ready(fn) {
      if (document.readyState === "complete") fn();
      else window.addEventListener("load", fn);
    }

    ready(function () {
      var root = document.getElementById("race-finder");
      if (!root) return;
      var races = Array.isArray(window.RACE_FINDER_DATA) ? window.RACE_FINDER_DATA.slice() : [];
      root.hidden = false;
      if (!races.length) {
        root.innerHTML =
          '<p class="rf-empty">Ancora nessuna gara in archivio: la ricerca comparirà al prossimo aggiornamento automatico.</p>';
        return;
      }

      // -------------------------------------------------- helpers (shared shape with wine_finder.liquid)
      function norm(s) {
        return String(s == null ? "" : s)
          .toLowerCase()
          .normalize("NFKD")
          .replace(/[\u0300-\u036f]/g, "")
          .replace(/[^a-z0-9\s]/g, " ")
          .replace(/\s+/g, " ")
          .trim();
      }
      function tokens(s) {
        var n = norm(s);
        return n ? n.split(" ") : [];
      }
      function esc(s) {
        return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
          return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
        });
      }
      function cap(s) {
        s = String(s == null ? "" : s).trim();
        return s ? s.charAt(0).toUpperCase() + s.slice(1) : s;
      }
      function uniq(a) {
        var o = {}, r = [];
        a.forEach(function (x) {
          if (x && !o[x]) {
            o[x] = 1;
            r.push(x);
          }
        });
        return r;
      }

      var CATEGORY_LABEL = { road: "Strada", trail: "Trail", skyrun: "Skyrun", ultra: "Ultra", triathlon: "Triathlon" };
      var DATE_FMT = new Intl.DateTimeFormat("it-IT", { day: "numeric", month: "short", year: "numeric" });
      function fmtDate(iso) {
        if (!iso) return "";
        var d = new Date(iso + "T00:00:00");
        return isNaN(d) ? iso : DATE_FMT.format(d);
      }

      // -------------------------------------------------- small concept lexicon: query
      // expansion + the "why this one" sentence. Deliberately smaller than wine's LEX —
      // races don't need a food-pairing table, just type/terrain/effort/season concepts.
      var LEX = [
        { s: ["montagna", "mountain", "alpin", "dislivello", "d+", "salita", "impegnativ"], a: ["trail", "skyrun", "ultra", "dislivello alto"], label: "gare di montagna" },
        { s: ["vino", "wine", "enoturismo", "vigne", "vigneto", "cantina", "degustazione"], a: ["vino"], label: "una gara tra i vigneti" },
        { s: ["skyrun", "skyrunning", "vertical", "verticale", "cima", "quota", "vetta"], a: ["skyrun"], label: "lo skyrunning" },
        { s: ["facile", "easy", "principiante", "beginner", "primo", "corta", "breve"], a: ["distanza corta", "strada"], label: "una gara accessibile" },
        { s: ["lunga", "lungo", "impegnativa", "estrema", "hard", "tosta"], a: ["ultra", "distanza lunga", "dislivello alto"], label: "una sfida lunga" },
        { s: ["acqua", "nuoto", "swim", "bici", "triathlon", "duathlon", "aquathlon"], a: ["triathlon"], label: "il triathlon" },
        { s: ["strada", "road", "asfalto", "maratona", "marathon", "mezza"], a: ["strada", "maratona"], label: "le gare su strada" },
        { s: ["trail", "sentiero", "bosco", "natura", "forest"], a: ["trail"], label: "il trail running" },
        { s: ["inverno", "winter", "gennaio", "febbraio", "dicembre"], a: ["stagione invernale"], label: "l'inverno" },
        { s: ["estate", "summer", "giugno", "luglio", "agosto"], a: ["stagione estiva"], label: "l'estate" },
        { s: ["francia", "france", "francese"], a: ["francia"], label: "la Francia" },
        { s: ["italia", "italy", "italiana"], a: ["italia"], label: "l'Italia" },
        { s: ["spagna", "spain", "spagnola"], a: ["spagna"], label: "la Spagna" },
        { s: ["svizzera", "switzerland", "svizzera"], a: ["svizzera"], label: "la Svizzera" },
        { s: ["austria", "austriaca"], a: ["austria"], label: "l'Austria" }
      ];
      function matchedLexRows(q) {
        var qn = " " + norm(q) + " ";
        return LEX.filter(function (row) {
          return row.s.some(function (term) {
            return qn.indexOf(" " + norm(term) + " ") >= 0 || qn.indexOf(norm(term)) >= 0;
          });
        });
      }
      function expandQuery(q) {
        var bag = tokens(q);
        matchedLexRows(q).forEach(function (row) {
          bag = bag.concat(tokens(row.a.join(" ")));
        });
        return uniq(bag);
      }

      // -------------------------------------------------- per-race derived facets + text
      function primaryDistance(r) {
        if (r.distance_km != null) return Number(r.distance_km);
        if (Array.isArray(r.distances_km) && r.distances_km.length) return Number(r.distances_km[0]);
        return null;
      }
      function keywordsOf(r) {
        var t = [r.name, r.region, r.series, r.country, CATEGORY_LABEL[r.category], r.organizer, r.notes];
        if (Array.isArray(r.tags) && r.tags.indexOf("wine") >= 0) t.push("vino");
        return uniq(tokens(t.filter(Boolean).join(" ")));
      }

      var META = races.map(function (r) {
        return {
          r: r,
          category: r.category || "",
          country: r.country || "",
          region: r.region || "",
          date: r.date || "",
          distance: primaryDistance(r),
          elevation: r.elevation_gain_m != null ? Number(r.elevation_gain_m) : null,
          wine: Array.isArray(r.tags) && r.tags.indexOf("wine") >= 0,
          kw: keywordsOf(r)
        };
      });

      // -------------------------------------------------- controls
      var countriesPresent = uniq(META.map(function (m) { return m.country; }).filter(Boolean)).sort();
      var hasElevation = META.some(function (m) { return m.elevation != null; });

      // Region only makes sense once a country is picked — "Rome" and "Rome, Georgia"
      // shouldn't collide, and a flat cross-country region list would be enormous and
      // mostly irrelevant. Keyed by normalized country.
      var regionsByCountry = {};
      META.forEach(function (m) {
        if (!m.country || !m.region) return;
        var key = norm(m.country);
        (regionsByCountry[key] = regionsByCountry[key] || {})[m.region] = 1;
      });

      var NO_MIN = -Infinity, NO_MAX = Infinity;
      var sel = {
        category: {}, country: "", region: "", q: "", wine: false,
        distMin: NO_MIN, distMax: NO_MAX, elevMin: NO_MIN, elevMax: NO_MAX,
        dateMin: "", dateMax: ""
      };

      var elCountry = document.getElementById("rf-country");
      var elRegion = document.getElementById("rf-region");
      var elWineToggle = document.getElementById("rf-wine-toggle");
      var elQ = document.getElementById("rf-q");
      var elForm = document.getElementById("rf-form");
      var elMoreToggle = document.getElementById("rf-more-toggle");
      var elMore = document.getElementById("rf-more");
      var elElevWrap = document.getElementById("rf-elev-wrap");
      var elResults = document.getElementById("rf-results");

      Array.prototype.forEach.call(document.querySelectorAll("#rf-category-quick .rf-chip"), function (b) {
        var c = b.getAttribute("data-category");
        b.onclick = function () {
          // Single-select: a race has exactly one category, so a second pick can only
          // ever intersect a first one down to zero — replace, don't add (same fix the
          // wine finder's type chips needed once they hit this same structural trap).
          var wasOn = !!sel.category[c];
          sel.category = {};
          Array.prototype.forEach.call(document.querySelectorAll("#rf-category-quick .rf-chip"), function (o) {
            o.setAttribute("aria-pressed", "false");
          });
          if (!wasOn) {
            sel.category[c] = 1;
            b.setAttribute("aria-pressed", "true");
          }
          run();
        };
      });
      countriesPresent.forEach(function (c) {
        var o = document.createElement("option");
        o.value = norm(c);
        o.textContent = cap(c);
        o.setAttribute("data-label", cap(c));
        elCountry.appendChild(o);
      });
      function populateRegions() {
        elRegion.innerHTML = '<option value="">Regione</option>';
        var regions = sel.country ? Object.keys(regionsByCountry[sel.country] || {}).sort() : [];
        elRegion.hidden = !sel.country || !regions.length;
        regions.forEach(function (r) {
          var o = document.createElement("option");
          o.value = r;
          o.textContent = cap(r);
          elRegion.appendChild(o);
        });
      }
      elCountry.onchange = function () {
        sel.country = elCountry.value;
        sel.region = ""; // a region from the previous country would silently mismatch
        populateRegions();
        run();
      };
      elRegion.onchange = function () {
        sel.region = elRegion.value;
        run();
      };
      elWineToggle.onclick = function () {
        sel.wine = !sel.wine;
        elWineToggle.setAttribute("aria-pressed", sel.wine ? "true" : "false");
        run();
      };
      if (hasElevation) elElevWrap.hidden = false;

      function numInput(id, key) {
        document.getElementById(id).oninput = function () {
          var v = parseFloat(this.value);
          sel[key] = isFinite(v) ? v : (key.indexOf("Min") >= 0 ? NO_MIN : NO_MAX);
          run();
        };
      }
      numInput("rf-dist-min", "distMin");
      numInput("rf-dist-max", "distMax");
      numInput("rf-elev-min", "elevMin");
      numInput("rf-elev-max", "elevMax");
      document.getElementById("rf-date-min").onchange = function () { sel.dateMin = this.value; run(); };
      document.getElementById("rf-date-max").onchange = function () { sel.dateMax = this.value; run(); };

      elMoreToggle.onclick = function () {
        var open = elMore.hidden;
        elMore.hidden = !open;
        elMoreToggle.setAttribute("aria-expanded", open ? "true" : "false");
      };
      document.getElementById("rf-clear").onclick = function () {
        sel = {
          category: {}, country: "", region: "", q: "", wine: false,
          distMin: NO_MIN, distMax: NO_MAX, elevMin: NO_MIN, elevMax: NO_MAX,
          dateMin: "", dateMax: ""
        };
        elQ.value = "";
        elCountry.value = "";
        populateRegions();
        ["rf-dist-min", "rf-dist-max", "rf-elev-min", "rf-elev-max", "rf-date-min", "rf-date-max"].forEach(function (id) {
          document.getElementById(id).value = "";
        });
        Array.prototype.forEach.call(root.querySelectorAll(".rf-chip"), function (b) {
          b.setAttribute("aria-pressed", "false");
        });
        run();
      };
      // The typed query only takes effect on submit — no result flickers into view while
      // the visitor is still typing (same fix wine_finder.liquid's query box needed).
      elForm.onsubmit = function (ev) {
        ev.preventDefault();
        sel.q = elQ.value.trim();
        run();
      };
      elQ.oninput = function () {
        if (!elQ.value.trim() && sel.q) {
          sel.q = "";
          run();
        }
      };

      // -------------------------------------------------- filter + score
      function passesFacets(m) {
        var catSel = Object.keys(sel.category);
        if (catSel.length && catSel.indexOf(m.category) < 0) return false;
        if (sel.country && norm(m.country) !== sel.country) return false;
        if (sel.region && m.region !== sel.region) return false;
        if (m.distance != null && (m.distance < sel.distMin || m.distance > sel.distMax)) return false;
        if (m.elevation != null && (m.elevation < sel.elevMin || m.elevation > sel.elevMax)) return false;
        if (sel.dateMin && m.date && m.date < sel.dateMin) return false;
        if (sel.dateMax && m.date && m.date > sel.dateMax) return false;
        if (sel.wine && !m.wine) return false;
        return true;
      }
      function keywordScore(expanded, m) {
        if (!expanded.length) return 0;
        var set = {};
        m.kw.forEach(function (t) { set[t] = 1; });
        var hits = 0;
        expanded.forEach(function (t) { if (set[t]) hits += 1; });
        return hits / Math.sqrt(expanded.length);
      }

      function reasonSentence(m) {
        var rows = sel.q ? matchedLexRows(sel.q) : [];
        if (rows.length) return "In linea con " + rows[0].label + ".";
        var catSel = Object.keys(sel.category);
        if (catSel.length) return "Tra le gare di categoria " + (CATEGORY_LABEL[catSel[0]] || catSel[0]) + ".";
        return "";
      }

      function metaLine(r) {
        var bits = [];
        if (r.region) bits.push(esc(cap(r.region)));
        var dist = primaryDistance(r);
        if (dist != null) bits.push(dist + " km");
        if (r.elevation_gain_m != null) bits.push("D+ " + r.elevation_gain_m + " m");
        return bits.join(" · ");
      }

      function badgeSlug(cat) {
        return cat || "other";
      }

      // A small, decorative marker only — the actual filter is the "🍷 Vino" toggle
      // chip, driven by m.wine, not this span.
      function wineBadge(m) {
        return m.wine ? ' <span class="no-tx" title="Si abbina a una zona o evento enologico">🍷</span>' : "";
      }

      function primaryCardHtml(m) {
        var r = m.r;
        var reason = reasonSentence(m);
        var meta = metaLine(r);
        var link = r.url
          ? '<a class="rf-link-btn no-tx" href="' + esc(r.url) + '" target="_blank" rel="noopener noreferrer">Sito della gara →</a>'
          : "";
        return (
          '<article class="rf-primary">' +
          '<span class="rf-badge rf-badge-' + badgeSlug(m.category) + '">' + esc(CATEGORY_LABEL[m.category] || m.category) + "</span>" +
          '<div class="rf-primary-name no-tx">' + esc(cap(r.name)) + "</div>" + wineBadge(m) +
          '<div class="rf-race-meta no-tx">' + esc(fmtDate(r.date)) + (meta ? " · " + meta : "") + "</div>" +
          (reason ? '<p class="rf-reason">' + esc(reason) + "</p>" : "") +
          '<div class="rf-actions">' +
          '<button type="button" class="rf-show" data-name="' + esc(r.name) + '" data-date="' + esc(r.date) + '">Vedi sulla mappa →</button>' +
          link +
          "</div>" +
          "</article>"
        );
      }
      var BROWSE_PAGE = 20;
      var browseShown = BROWSE_PAGE;

      // Same (normalized) name + country within a couple of days of each other is
      // almost always one event with several distances/editions on one weekend (e.g.
      // "Rome" on both the 3rd and the 4th) rather than two unrelated races — shown as
      // one row with a date range instead of duplicate-looking rows. Assumes `list` is
      // already date-sorted, so anything to group with sits immediately adjacent.
      var GROUP_MAX_GAP_DAYS = 2;
      function groupNearbyDates(list) {
        var groups = [];
        list.forEach(function (m) {
          var last = groups[groups.length - 1];
          if (last) {
            var head = last[0].r;
            var gapDays = Math.round((new Date(m.r.date + "T00:00:00") - new Date(last[last.length - 1].r.date + "T00:00:00")) / 86400000);
            if (norm(head.name) === norm(m.r.name) && head.country === m.r.country && gapDays >= 0 && gapDays <= GROUP_MAX_GAP_DAYS) {
              last.push(m);
              return;
            }
          }
          groups.push([m]);
        });
        return groups;
      }
      function dateRangeLabel(group) {
        var first = fmtDate(group[0].r.date), last = fmtDate(group[group.length - 1].r.date);
        return first === last ? first : first + "–" + last;
      }
      function distanceListLabel(group) {
        var ds = uniq(group.map(function (m) { return m.distance != null ? String(m.distance) : null; }).filter(Boolean));
        return ds.join(", ");
      }

      function browseTableHtml(rows) {
        var groups = groupNearbyDates(rows);
        var shown = groups.slice(0, browseShown);
        var html =
          '<div class="rf-table-wrap"><table class="rf-table"><thead><tr>' +
          "<th>Data</th><th>Gara</th><th class='rf-col-region'>Luogo</th><th>Tipo</th><th>Km</th><th></th>" +
          "</tr></thead><tbody>" +
          shown
            .map(function (group) {
              var m = group[0], r = m.r;
              var link = r.url
                ? '<a class="rf-link no-tx" href="' + esc(r.url) + '" target="_blank" rel="noopener noreferrer">info</a>'
                : "";
              var countBadge = group.length > 1 ? ' <span class="no-tx rf-race-meta">×' + group.length + "</span>" : "";
              return (
                "<tr>" +
                '<td class="no-tx">' + esc(dateRangeLabel(group)) + "</td>" +
                '<td><span class="rf-race-name no-tx">' + esc(cap(r.name)) + "</span>" + wineBadge(m) + countBadge + "</td>" +
                '<td class="rf-col-region no-tx">' + esc(cap(r.region || "")) + "</td>" +
                '<td><span class="rf-badge rf-badge-' + badgeSlug(m.category) + '">' + esc(CATEGORY_LABEL[m.category] || m.category) + "</span></td>" +
                '<td class="no-tx">' + esc(distanceListLabel(group)) + "</td>" +
                "<td>" +
                '<button type="button" class="rf-map-btn no-tx" ' +
                'data-name="' + esc(r.name) + '" data-date="' + esc(r.date) + '">mappa</button> ' +
                link +
                "</td>" +
                "</tr>"
              );
            })
            .join("") +
          "</tbody></table></div>";
        if (groups.length > shown.length) {
          html += '<button type="button" class="rf-show-more">Mostra altre (' + (groups.length - shown.length) + ")</button>";
        }
        return html;
      }

      function wireActions() {
        Array.prototype.forEach.call(elResults.querySelectorAll("[data-name][data-date]"), function (btn) {
          btn.onclick = function () {
            window.dispatchEvent(
              new CustomEvent("racefinder:show", {
                detail: { name: btn.getAttribute("data-name"), date: btn.getAttribute("data-date") },
              })
            );
          };
        });
        var more = elResults.querySelector(".rf-show-more");
        if (more) {
          more.onclick = function () {
            browseShown += BROWSE_PAGE;
            render();
          };
        }
      }

      function hasCriteria() {
        return (
          !!sel.q ||
          Object.keys(sel.category).length > 0 ||
          !!sel.country ||
          isFinite(sel.distMin) || isFinite(sel.distMax) ||
          isFinite(sel.elevMin) || isFinite(sel.elevMax) ||
          !!sel.dateMin || !!sel.dateMax || sel.wine
        );
      }

      function render() {
        if (!hasCriteria()) {
          elResults.innerHTML = "";
          return;
        }
        var expanded = sel.q ? expandQuery(sel.q) : [];
        var rows = [];
        META.forEach(function (m) {
          if (!passesFacets(m)) return;
          rows.push({ m: m, kw: keywordScore(expanded, m) });
        });

        if (!rows.length) {
          elResults.innerHTML =
            '<p class="rf-empty">Nessuna gara con questi criteri. Allarga il periodo o togli un filtro.</p>';
          return;
        }

        var html;
        if (sel.q) {
          // Query mode: highlight the single best keyword match, same as the wine
          // finder — but unlike wine, everything else that also matches gets listed
          // too (as many races as fit the filters, not capped at a couple of
          // runners-up): this is a season-planning tool, not a one-pick recommendation.
          rows.sort(function (a, b) { return b.kw - a.kw || a.m.date.localeCompare(b.m.date); });
          var primary = rows[0];
          var rest = rows.slice(1).sort(function (a, b) { return a.m.date.localeCompare(b.m.date); });
          html = '<h3 class="rf-h">La mia scelta</h3>' + primaryCardHtml(primary.m);
          if (rest.length) {
            html +=
              '<h3 class="rf-h">Altre gare in linea (' + rest.length + ")</h3>" +
              browseTableHtml(rest.map(function (r) { return r.m; }));
          }
        } else {
          // Browse mode: every match, soonest first — the actual season-planning view.
          rows.sort(function (a, b) { return a.m.date.localeCompare(b.m.date); });
          html = '<h3 class="rf-h">' + rows.length + (rows.length === 1 ? " gara trovata" : " gare trovate") + "</h3>" +
            browseTableHtml(rows.map(function (r) { return r.m; }));
        }
        elResults.innerHTML = html;
        wireActions();

        if (window.WineI18n && window.WineI18n.lang === "en") window.WineI18n.translate(elResults);
      }

      function run() {
        browseShown = BROWSE_PAGE;
        render();
      }

      if (window.WineI18n) window.WineI18n.onChange(function () { render(); });

      run();
    });
  })();
</script>
