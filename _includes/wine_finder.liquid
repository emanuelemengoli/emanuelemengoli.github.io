</style>

<div id="wine-finder" hidden>
  <div class="wf-hero">
    <label class="wf-hero-label" for="wf-q">Che vino cerchi?</label>
    <form id="wf-form" class="wf-hero-row">
      <input
        type="search"
        id="wf-q"
        autocomplete="off"
        placeholder="brasato, aperitivo estivo, regalo sui 30 €…"
      />
      <button type="submit" id="wf-go">Consiglia</button>
    </form>
  </div>

  <div class="wf-quick">
    <div class="wf-chips" id="wf-type-quick">
      <button type="button" class="wf-chip" data-type="red">Rosso</button>
      <button type="button" class="wf-chip" data-type="white">Bianco</button>
      <button type="button" class="wf-chip" data-type="rosé">Rosé</button>
      <button type="button" class="wf-chip" data-type="sparkling">Bollicine</button>
    </div>
    <select id="wf-region" aria-label="Regione"><option value="">Regione</option></select>
    <span class="wf-num">
      <span class="wf-num-pre">€</span>
      <input type="number" id="wf-price" min="0" step="1" inputmode="decimal" aria-label="Prezzo massimo" />
    </span>
    <button type="button" id="wf-more-toggle" class="wf-ghost" aria-expanded="false" aria-controls="wf-more">Altri filtri</button>
    <button type="button" id="wf-clear" class="wf-ghost">Pulisci</button>
  </div>

  <div id="wf-more" class="wf-more" hidden>
    <div class="wf-facet">
      <span class="wf-label">Occasione</span>
      <div class="wf-chips" id="wf-occasion"></div>
    </div>
    <div class="wf-facet" id="wf-type-extra-wrap" hidden>
      <span class="wf-label">Altro tipo</span>
      <div class="wf-chips" id="wf-type-extra"></div>
    </div>
  </div>

  <div id="wf-boost" class="wf-boost" hidden>
    <button type="button" id="wf-boost-btn">Migliora i suggerimenti</button>
    <small id="wf-boost-note">una tantum, ~25&nbsp;MB</small>
  </div>
  <div id="wf-status" class="wf-status" hidden aria-hidden="true">
    <span class="wf-progress"><i id="wf-progress-fill"></i></span>
  </div>

  <div id="wf-results" class="wf-results" aria-live="polite"></div>
</div>

<script>
  window.WINE_FINDER_DATA = {{ site.data.wines | jsonify | replace: '</', '<\/' }};
</script>

<script>
  (function () {
    function ready(fn) {
      if (document.readyState === "complete") fn();
      else window.addEventListener("load", fn);
    }

    ready(function () {
      var root = document.getElementById("wine-finder");
      if (!root) return;
      var wines = Array.isArray(window.WINE_FINDER_DATA) ? window.WINE_FINDER_DATA.slice() : [];
      root.hidden = false;
      if (!wines.length) {
        root.innerHTML =
          '<p class="wf-empty">Ancora nessun vino in archivio: la ricerca comparirà con la prima degustazione.</p>';
        return;
      }

      // -------------------------------------------------- helpers
      function norm(s) {
        return String(s == null ? "" : s)
          .toLowerCase()
          .normalize("NFKD")
          .replace(/[\u0300-\u036f]/g, "")
          .replace(/[^a-z0-9\s]/g, " ")
          .replace(/\s+/g, " ")
          .trim();
      }
      function tokens(s) {
        var n = norm(s);
        return n ? n.split(" ") : [];
      }
      function esc(s) {
        return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
          return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
        });
      }
      function cap(s) {
        s = String(s == null ? "" : s).trim();
        return s ? s.charAt(0).toUpperCase() + s.slice(1) : s;
      }
      function uniq(a) {
        var o = {}, r = [];
        a.forEach(function (x) {
          if (x && !o[x]) {
            o[x] = 1;
            r.push(x);
          }
        });
        return r;
      }
      function wineKey(w) {
        return norm(w.producer) + "|" + norm(w.name) + "|" + (w.vintage || "");
      }
      function priceNum(w) {
        var m = String(w.price == null ? "" : w.price).replace(",", ".").match(/\d+(\.\d+)?/);
        return m ? parseFloat(m[0]) : null;
      }
      function hash(s) {
        var h = 5381, i = s.length;
        while (i) h = (h * 33) ^ s.charCodeAt(--i);
        return (h >>> 0).toString(36);
      }
      var TYPE_LABEL = {
        red: "Rosso", white: "Bianco", "rosé": "Rosé", rose: "Rosé",
        sparkling: "Bollicine", orange: "Arancione",
      };
      function typeKey(w) {
        var c = norm(w.color);
        return c === "rose" ? "rosé" : c;
      }
      function badgeSlug(t) {
        return t === "rosé" ? "rose" : t || "other";
      }

      // -------------------------------------------------- concept lexicon (query expansion
      // AND the natural-language reason shown on a card). k: "food" | "occasion".
      var LEX = [
        { s: ["carne rossa", "manzo", "beef", "bistecca", "steak", "brasato", "brasati", "stufato", "stew", "arrosto", "roast", "selvaggina", "game", "cinghiale", "agnello", "lamb", "cervo"], a: ["rosso", "tannico", "strutturato", "corpo pieno", "invecchiato"], k: "food", label: "brasati e carni importanti" },
        { s: ["maiale", "pork", "salumi", "prosciutto", "salame", "porchetta"], a: ["rosso", "medio corpo", "fresco", "bollicine"], k: "food", label: "salumi" },
        { s: ["pollo", "chicken", "tacchino", "coniglio", "carne bianca", "white meat"], a: ["bianco strutturato", "rosso leggero", "rosato"], k: "food", label: "carni bianche" },
        { s: ["pesce", "fish", "branzino", "orata", "spigola", "tonno", "tuna", "salmone", "salmon", "merluzzo", "cod"], a: ["bianco", "fresco", "sapido", "acidita alta", "leggero"], k: "food", label: "il pesce" },
        { s: ["crudo", "sashimi", "sushi", "ostriche", "oyster", "crostacei", "shellfish", "gamberi", "scampi", "frutti di mare", "vongole", "clams", "tartare"], a: ["bianco", "bollicine", "sapido", "minerale", "acidita alta"], k: "food", label: "crudi e crostacei" },
        { s: ["formaggio", "formaggi", "cheese", "pecorino", "parmigiano", "gorgonzola", "erborinato", "blue cheese", "brie", "camembert", "caprino", "goat cheese", "stagionato"], a: ["strutturato", "rosso", "bianco maturo", "dolce", "passito"], k: "food", label: "i formaggi" },
        { s: ["pasta", "risotto", "primo", "gnocchi", "lasagne", "ragu", "ragout", "tagliatelle", "carbonara", "amatriciana", "pomodoro", "tomato"], a: ["rosso", "medio corpo", "acidita", "fresco"], k: "food", label: "i primi piatti" },
        { s: ["pizza", "focaccia"], a: ["rosso fresco", "bollicine", "medio corpo"], k: "food", label: "la pizza" },
        { s: ["tartufo", "truffle", "funghi", "mushroom", "porcini"], a: ["rosso", "evoluto", "terziario", "strutturato"], k: "food", label: "i piatti al tartufo" },
        { s: ["dessert", "dolce", "torta", "cake", "pasticceria", "cioccolato", "chocolate", "biscotti", "crostata"], a: ["dolce", "passito", "spumante dolce", "vendemmia tardiva"], k: "food", label: "il dessert" },
        { s: ["aperitivo", "aperitif", "stuzzichini", "snack", "tapas", "cicchetti", "fritto", "fried", "patatine", "olive", "finger food"], a: ["bollicine", "bianco", "rosato", "fresco", "leggero", "secco"], k: "occasion", label: "un aperitivo" },
        { s: ["piccante", "spicy", "speziato", "curry", "peperoncino", "messicano", "mexican", "thai", "indiano", "indian"], a: ["bianco aromatico", "morbido", "dolce", "bassa acidita", "fruttato"], k: "food", label: "i piatti speziati" },
        { s: ["vegetariano", "vegan", "verdure", "vegetables", "insalata", "salad", "zuppa", "soup", "legumi"], a: ["bianco", "rosato", "leggero", "fresco", "erbaceo"], k: "food", label: "i piatti vegetariani" },
        { s: ["barbecue", "bbq", "grigliata", "grill", "affumicato", "smoked"], a: ["rosso", "tannico", "corpo pieno", "speziato"], k: "food", label: "le grigliate" },
        { s: ["estate", "summer", "picnic", "spiaggia", "beach", "caldo", "terrazza", "giardino", "garden"], a: ["bianco", "rosato", "bollicine", "fresco", "leggero", "beva"], k: "occasion", label: "l'estate" },
        { s: ["inverno", "winter", "freddo", "cold", "camino", "fireplace", "comfort"], a: ["rosso", "strutturato", "caldo", "corpo pieno", "invecchiato"], k: "occasion", label: "l'inverno" },
        { s: ["celebrazione", "festa", "party", "brindisi", "toast", "celebration", "anniversario", "anniversary", "compleanno", "birthday", "matrimonio", "wedding", "laurea"], a: ["bollicine", "spumante", "champagne", "metodo classico", "pregiato"], k: "occasion", label: "una celebrazione" },
        { s: ["regalo", "gift", "dono", "present", "da collezione", "collector"], a: ["pregiato", "icona", "invecchiato", "punteggio alto"], k: "occasion", label: "un regalo" },
        { s: ["cena importante", "cena elegante", "fine dining", "occasione speciale", "special occasion", "romantica", "romantic"], a: ["rosso strutturato", "pregiato", "complesso", "punteggio alto", "invecchiato"], k: "occasion", label: "una cena importante" },
        { s: ["tutti i giorni", "everyday", "quotidiano", "weeknight", "semplice", "easy", "economico", "cheap", "budget", "informale", "casual"], a: ["prezzo basso", "beva", "leggero", "fruttato", "versatile"], k: "occasion", label: "tutti i giorni" },
      ];
      function matchedLexRows(q) {
        var qn = " " + norm(q) + " ";
        return LEX.filter(function (row) {
          return row.s.some(function (term) {
            return qn.indexOf(" " + norm(term) + " ") >= 0 || qn.indexOf(norm(term)) >= 0;
          });
        });
      }
      function expandQuery(q) {
        var bag = tokens(q);
        matchedLexRows(q).forEach(function (row) {
          bag = bag.concat(tokens(row.a.join(" ")), tokens(row.s[0]));
        });
        return uniq(bag);
      }
      // What the query is "about", for the reason sentence — not the ranking maths above.
      function queryConcepts(q) {
        var food = [], occ = [];
        matchedLexRows(q).forEach(function (row) {
          (row.k === "occasion" ? occ : food).push(row.label);
        });
        return { food: uniq(food), occ: uniq(occ) };
      }
      function qPriceFromQuery(q) {
        var m = String(q || "").match(/(\d{1,4})\s*(?:€|eur\b|euro)/i) || String(q || "").match(/€\s*(\d{1,4})/i);
        return m ? parseInt(m[1], 10) : null;
      }
      function humanJoin(arr) {
        if (arr.length <= 1) return arr[0] || "";
        return arr.slice(0, -1).join(", ") + " e " + arr[arr.length - 1];
      }

      // -------------------------------------------------- per-wine derived facets + text
      var REGION_ALIAS = {
        piemonte: "piedmont", borgogna: "burgundy", toscana: "tuscany", sicilia: "sicily",
        lombardia: "lombardy", "alto adige": "south tyrol", italia: "italy", francia: "france",
      };
      function structured(w) {
        var p = (w.tasting && w.tasting.palate) || {};
        return /strutturato|pieno|potent/i.test((p.corpo || "") + " " + (p.tannini || ""));
      }
      function crisp(w) {
        var p = (w.tasting && w.tasting.palate) || {};
        return /elevat|alta/i.test(p.acidita || "");
      }
      function sweetish(w) {
        var p = (w.tasting && w.tasting.palate) || {};
        return /dolce|demi|morbid/i.test(p.zucchero || "");
      }
      function occasionsOf(w) {
        if (Array.isArray(w.occasions) && w.occasions.length) return uniq(w.occasions.map(norm));
        var t = typeKey(w), r = Number(w.rating) || 0, pr = priceNum(w), out = [];
        if (t === "sparkling" || w.sparkling) out.push("aperitivo", "celebrazione", "estate");
        if (t === "white" || t === "rosé") out.push("aperitivo", "estate");
        if (t === "red") out.push("cena importante", "inverno");
        if (t === "orange") out.push("cena importante");
        if (structured(w)) out.push("cena importante");
        if (r >= 4.5) out.push("occasione speciale", "regalo");
        if (pr != null && pr >= 40) out.push("regalo", "celebrazione");
        if (pr != null && pr <= 15) out.push("tutti i giorni");
        return uniq(out);
      }
      function foodTagsOf(w) {
        var out = tokens(w.pairing).concat(tokens(w.notes));
        if (Array.isArray(w.food_tags)) out = out.concat(tokens(w.food_tags.join(" ")));
        var t = typeKey(w);
        if (t === "red" && structured(w)) out = out.concat(tokens("carne rossa brasati selvaggina formaggi stagionati tartufo"));
        if (t === "red" && !structured(w)) out = out.concat(tokens("pasta pizza salumi pollo"));
        if (t === "white" && crisp(w)) out = out.concat(tokens("pesce crostacei ostriche fritti insalata"));
        if (t === "white" && !crisp(w)) out = out.concat(tokens("pollo risotto formaggi molli"));
        if (t === "rosé") out = out.concat(tokens("aperitivo pesce insalata salumi estate"));
        if (t === "sparkling") out = out.concat(tokens("aperitivo fritti sushi ostriche celebrazione"));
        if (t === "orange") out = out.concat(tokens("formaggi speziato cucina orientale"));
        if (sweetish(w)) out = out.concat(tokens("dessert dolce pasticceria formaggi erborinati"));
        return uniq(out);
      }
      function attrTokensOf(w) {
        var t = typeKey(w), out = [TYPE_LABEL[t] || t];
        if (t === "sparkling" || w.sparkling) out.push("bollicine", "spumante");
        if (structured(w)) out.push("strutturato", "corpo pieno", "tannico");
        else out.push("leggero", "beva");
        if (crisp(w)) out.push("fresco", "acidita alta", "sapido");
        if (sweetish(w)) out.push("dolce", "passito");
        var ev = (w.tasting && w.tasting.nose && w.tasting.nose.evoluzione) || "";
        if (/evolu|corso|totalment/i.test(ev)) out.push("evoluto", "terziario", "invecchiato");
        var pr = priceNum(w);
        if (pr != null && pr >= 40) out.push("pregiato", "punteggio alto");
        if (pr != null && pr <= 15) out.push("prezzo basso", "versatile");
        if ((Number(w.rating) || 0) >= 4.5) out.push("pregiato", "punteggio alto", "icona");
        return tokens(out.join(" "));
      }
      function profileText(w) {
        var parts = [
          w.name, w.vintage, w.producer, w.denominazione, w.region, w.country, w.grape,
          TYPE_LABEL[typeKey(w)],
          (w.region && REGION_ALIAS[norm(w.region)]) || "",
          (w.country && REGION_ALIAS[norm(w.country)]) || "",
          occasionsOf(w).join(" "),
          foodTagsOf(w).join(" "),
          attrTokensOf(w).join(" "),
          w.pairing, w.notes,
        ];
        var tv = w.tasting || {};
        ["visual", "nose", "palate"].forEach(function (sec) {
          var o = tv[sec];
          if (!o) return;
          Object.keys(o).forEach(function (k) {
            var v = o[k];
            parts.push(Array.isArray(v) ? v.join(" ") : v);
          });
        });
        return parts.filter(Boolean).join(" · ");
      }
      function hasSheet(w) {
        var tv = w.tasting;
        if (!tv || typeof tv !== "object") return false;
        return ["visual", "nose", "palate"].some(function (sec) {
          var o = tv[sec];
          return (
            o &&
            typeof o === "object" &&
            Object.keys(o).some(function (k) {
              var v = o[k];
              return Array.isArray(v) ? v.length > 0 : !!(v && String(v).trim());
            })
          );
        });
      }

      var META = wines.map(function (w) {
        var text = profileText(w);
        return {
          w: w,
          key: wineKey(w),
          type: typeKey(w),
          region: w.region || "",
          price: priceNum(w),
          rating: Number(w.rating) || 0,
          occ: occasionsOf(w),
          kw: uniq(attrTokensOf(w).concat(foodTagsOf(w), tokens(text))),
          text: text,
          vhash: hash(text),
        };
      });

      // -------------------------------------------------- controls
      var typesPresent = uniq(META.map(function (m) { return m.type; })).filter(Boolean);
      var regionsPresent = uniq(META.map(function (m) { return m.region; }).filter(Boolean)).sort();
      var prices = META.map(function (m) { return m.price; }).filter(function (p) { return p != null; });
      var priceMax = prices.length ? Math.ceil(Math.max.apply(null, prices) / 5) * 5 : 100;
      var OCCASIONS = ["aperitivo", "cena importante", "celebrazione", "tutti i giorni", "estate", "inverno", "regalo"];
      var OCC_PHRASE = {
        aperitivo: "un aperitivo", "cena importante": "una cena importante", celebrazione: "una celebrazione",
        "tutti i giorni": "tutti i giorni", estate: "l'estate", inverno: "l'inverno", regalo: "un regalo",
      };
      var TYPE_PHRASE = {
        red: "Tra i rossi della collezione.", white: "Tra i bianchi della collezione.",
        "rosé": "Tra i rosé della collezione.", sparkling: "Tra le bollicine della collezione.",
        orange: "Tra gli arancioni della collezione.",
      };

      var NO_CAP = Infinity;
      var sel = { type: {}, occ: {}, region: "", price: NO_CAP, q: "" };

      var elRegion = document.getElementById("wf-region");
      var elPrice = document.getElementById("wf-price");
      var elQ = document.getElementById("wf-q");
      var elForm = document.getElementById("wf-form");
      var elMoreToggle = document.getElementById("wf-more-toggle");
      var elMore = document.getElementById("wf-more");
      var elOcc = document.getElementById("wf-occasion");
      var elTypeExtraWrap = document.getElementById("wf-type-extra-wrap");
      var elTypeExtra = document.getElementById("wf-type-extra");
      var elResults = document.getElementById("wf-results");
      var elStatus = document.getElementById("wf-status");
      var elProgFill = document.getElementById("wf-progress-fill");
      var elBoost = document.getElementById("wf-boost");
      var elBoostBtn = document.getElementById("wf-boost-btn");
      var elBoostNote = document.getElementById("wf-boost-note");

      function chip(container, value, label, store) {
        var b = document.createElement("button");
        b.type = "button";
        b.className = "wf-chip";
        b.textContent = label;
        b.setAttribute("aria-pressed", "false");
        b.onclick = function () {
          if (store[value]) {
            delete store[value];
            b.setAttribute("aria-pressed", "false");
          } else {
            store[value] = 1;
            b.setAttribute("aria-pressed", "true");
          }
          run();
        };
        container.appendChild(b);
      }
      Array.prototype.forEach.call(document.querySelectorAll("#wf-type-quick .wf-chip"), function (b) {
        var t = b.getAttribute("data-type");
        b.onclick = function () {
          if (sel.type[t]) {
            delete sel.type[t];
            b.setAttribute("aria-pressed", "false");
          } else {
            sel.type[t] = 1;
            b.setAttribute("aria-pressed", "true");
          }
          run();
        };
      });
      var QUICK_TYPES = ["red", "white", "rosé", "sparkling"];
      var extraTypes = typesPresent.filter(function (t) { return QUICK_TYPES.indexOf(t) < 0; });
      if (extraTypes.length) {
        elTypeExtraWrap.hidden = false;
        extraTypes.forEach(function (t) { chip(elTypeExtra, t, cap(TYPE_LABEL[t] || t), sel.type); });
      }
      OCCASIONS.forEach(function (o) { chip(elOcc, o, cap(o), sel.occ); });
      regionsPresent.forEach(function (r) {
        var o = document.createElement("option");
        o.value = norm(r);
        o.textContent = cap(r);
        o.setAttribute("data-label", cap(r));
        elRegion.appendChild(o);
      });
      elRegion.onchange = function () {
        sel.region = elRegion.value;
        sel.regionLabel = elRegion.options[elRegion.selectedIndex].getAttribute("data-label") || "";
        run();
      };
      elPrice.placeholder = String(priceMax);
      elPrice.oninput = function () {
        var v = parseFloat(String(elPrice.value).replace(",", "."));
        sel.price = isFinite(v) && v > 0 ? v : NO_CAP;
        run();
      };
      elMoreToggle.onclick = function () {
        var open = elMore.hidden;
        elMore.hidden = !open;
        elMoreToggle.setAttribute("aria-expanded", open ? "true" : "false");
      };
      document.getElementById("wf-clear").onclick = function () {
        sel = { type: {}, occ: {}, region: "", price: NO_CAP, q: "" };
        elQ.value = "";
        elRegion.value = "";
        elPrice.value = "";
        Array.prototype.forEach.call(root.querySelectorAll(".wf-chip"), function (b) {
          b.setAttribute("aria-pressed", "false");
        });
        run();
      };
      elForm.onsubmit = function (ev) {
        ev.preventDefault();
        sel.q = elQ.value.trim();
        if (boostOn && sel.q) ensureSemantic();
        run();
      };
      var qDebounce;
      elQ.oninput = function () {
        clearTimeout(qDebounce);
        qDebounce = setTimeout(function () {
          sel.q = elQ.value.trim();
          if (boostOn && sel.q) ensureSemantic();
          run();
        }, 250);
      };

      // -------------------------------------------------- semantic layer (optional, opt-in)
      var SEM = { ready: false, loading: false, vecs: null, qcache: {} };
      var elProgTrack = elStatus.querySelector(".wf-progress");
      var boostOn = false;
      try { boostOn = localStorage.getItem("wine-finder-boost") === "1"; } catch (e) {}

      // frac: 0..1 determinate · null indeterminate · "error" · false hide — a bar only,
      // no wording about models, downloads or algorithms.
      function showProgress(frac) {
        if (frac === false) {
          elStatus.hidden = true;
          elProgTrack.className = "wf-progress";
          elProgFill.style.width = "0";
          return;
        }
        elStatus.hidden = false;
        if (frac === "error") {
          elProgTrack.className = "wf-progress wf-error";
          setTimeout(function () { showProgress(false); }, 2200);
          return;
        }
        if (frac == null) {
          elProgTrack.className = "wf-progress wf-indet";
          elProgFill.style.width = "100%";
          return;
        }
        elProgTrack.className = "wf-progress";
        elProgFill.style.width = Math.max(4, Math.round(frac * 100)) + "%";
      }
      function ensureModuleTag() {
        if (document.getElementById("wf-sem-mod")) return;
        var s = document.createElement("script");
        s.type = "module";
        s.id = "wf-sem-mod";
        s.src = "{{ '/assets/js/wine_finder_semantic.js' | relative_url }}";
        document.head.appendChild(s);
      }
      function ensureSemantic() {
        if (SEM.ready || SEM.loading) return;
        if (!("indexedDB" in window)) return;
        ensureModuleTag();
        SEM.loading = true;
        updateBoostVisibility();
        showProgress(null);
        var start = function () {
          window.WineSemantic
            .pipe(function (pct) { showProgress(0.05 + 0.75 * (pct / 100)); })
            .then(function () {
              showProgress(0.82);
              var items = META.map(function (m) { return { key: "wf:" + m.vhash, text: m.text }; });
              return window.WineSemantic.embedCorpus(items, function (done, total) {
                showProgress(0.82 + 0.18 * (done / total));
              });
            })
            .then(function (vecs) {
              SEM.vecs = vecs;
              SEM.ready = true;
              SEM.loading = false;
              showProgress(false);
              run();
            })
            .catch(function (err) {
              SEM.loading = false;
              showProgress("error");
              updateBoostVisibility();
              if (window.console) console.warn("wine-finder semantic:", err);
            });
        };
        if (window.WineSemantic) start();
        else window.addEventListener("winesemantic:ready", start, { once: true });
      }
      if (boostOn) ensureModuleTag(); // warm the module (not the model) for a returning visitor

      function updateBoostVisibility() {
        var show = !!sel.q && !SEM.ready && !SEM.loading && !boostOn;
        elBoost.hidden = !show;
      }
      elBoostBtn.onclick = function () {
        boostOn = true;
        try { localStorage.setItem("wine-finder-boost", "1"); } catch (e) {}
        if (elBoostNote) elBoostNote.hidden = true;
        updateBoostVisibility();
        ensureSemantic();
      };

      function semScoreFor(m) {
        if (!SEM.ready || !sel.q) return null;
        var qv = SEM.qcache[sel.q];
        var wv = SEM.vecs && SEM.vecs["wf:" + m.vhash];
        if (!qv || !wv) return null;
        return (window.WineSemantic.cosine(qv, wv) + 1) / 2;
      }
      function ensureQueryVector(cb) {
        if (!SEM.ready || !sel.q || SEM.qcache[sel.q]) {
          cb();
          return;
        }
        window.WineSemantic.embed(sel.q)
          .then(function (v) { SEM.qcache[sel.q] = v; cb(); })
          .catch(function () { cb(); });
      }

      // -------------------------------------------------- filter + score
      function passesFacets(m) {
        if (Object.keys(sel.type).length && !sel.type[m.type]) return false;
        if (sel.region && norm(m.region) !== sel.region) return false;
        if (m.price != null && m.price > sel.price + 0.001) return false;
        var occSel = Object.keys(sel.occ);
        if (occSel.length && !occSel.some(function (o) { return m.occ.indexOf(o) >= 0; })) return false;
        return true;
      }
      function keywordScore(expanded, m) {
        if (!expanded.length) return 0;
        var set = {};
        m.kw.forEach(function (t) { set[t] = 1; });
        var hits = 0;
        expanded.forEach(function (t) { if (set[t]) hits += 1; });
        return hits / Math.sqrt(expanded.length);
      }
      function starStr(r) {
        r = Math.max(0, Math.min(5, Number(r) || 0));
        var full = Math.floor(r), half = r - full >= 0.5, s = "";
        var i;
        for (i = 0; i < full; i++) s += "★";
        if (half) s += "⯪";
        for (i = full + (half ? 1 : 0); i < 5; i++) s += "☆";
        return s;
      }
      function strengthHtml(v) {
        var n = Math.max(1, Math.min(5, Math.round(v * 5)));
        var out = "";
        for (var i = 1; i <= 5; i++) out += '<i class="' + (i <= n ? "on" : "") + '"></i>';
        return '<span class="wf-strength" role="img" aria-label="corrispondenza ' + n + ' su 5">' + out + "</span>";
      }

      // A short, wine/user-oriented sentence — never algorithmic wording.
      function reasonSentence(m) {
        var concepts = sel.q ? queryConcepts(sel.q) : { food: [], occ: [] };
        var qPrice = sel.q ? qPriceFromQuery(sel.q) : null;
        if (qPrice == null && isFinite(sel.price)) qPrice = Math.round(sel.price);

        if (concepts.food.length) {
          return "Ottimo con " + humanJoin(concepts.food.slice(0, 2)) + ".";
        }
        var chipOcc = Object.keys(sel.occ).filter(function (o) { return m.occ.indexOf(o) >= 0; });
        var occPhrase = concepts.occ[0] || (chipOcc.length ? OCC_PHRASE[chipOcc[0]] : null);
        if (occPhrase) {
          return "Una buona scelta per " + occPhrase + (qPrice ? " intorno ai " + qPrice + " €" : "") + ".";
        }
        var typeSel = Object.keys(sel.type);
        if (typeSel.length) {
          return TYPE_PHRASE[typeSel[0]] || "Un vino di riferimento della collezione.";
        }
        if (sel.q || sel.region || isFinite(sel.price)) {
          return "Un vino di riferimento della collezione.";
        }
        return "";
      }

      function primaryCardHtml(r) {
        var w = r.m.w;
        var reason = reasonSentence(r.m);
        var meta = [w.region, w.grape].filter(Boolean).map(esc).join(" · ");
        var sheet = hasSheet(w)
          ? '<button type="button" class="wf-sheet" data-name="' + esc(w.name) + '" data-producer="' + esc(w.producer) + '">Scheda completa</button>'
          : "";
        return (
          '<article class="wf-primary">' +
          '<div class="wf-card-top">' +
          '<span class="wf-badge wf-badge-' + badgeSlug(r.m.type) + '">' + esc(cap(TYPE_LABEL[r.m.type] || r.m.type)) + "</span>" +
          '<span class="wf-stars" aria-label="' + r.m.rating + ' / 5">' + starStr(r.m.rating) + "</span>" +
          (r.m.price != null ? '<span class="wf-price-tag">€ ' + esc(r.m.price) + "</span>" : "") +
          "</div>" +
          '<div class="wf-primary-name no-tx">' + esc(w.name) + (w.vintage ? " " + esc(w.vintage) : "") + "</div>" +
          '<div class="wf-card-prod no-tx">' + esc(w.producer) + "</div>" +
          (meta ? '<div class="wf-card-meta">' + meta + "</div>" : "") +
          (reason ? '<p class="wf-reason">' + esc(reason) + "</p>" : "") +
          '<div class="wf-actions">' +
          '<button type="button" class="wf-show" data-name="' + esc(w.name) + '" data-producer="' + esc(w.producer) + '">Vedi sulla mappa →</button>' +
          sheet +
          "</div>" +
          "</article>"
        );
      }
      function compactCardHtml(r, strength) {
        var w = r.m.w;
        var reason = reasonSentence(r.m);
        var meta = [w.region, w.grape].filter(Boolean).map(esc).join(" · ");
        return (
          '<article class="wf-card">' +
          '<div class="wf-card-top">' +
          '<span class="wf-badge wf-badge-' + badgeSlug(r.m.type) + '">' + esc(cap(TYPE_LABEL[r.m.type] || r.m.type)) + "</span>" +
          strengthHtml(strength) +
          '<span class="wf-stars" aria-label="' + r.m.rating + ' / 5">' + starStr(r.m.rating) + "</span>" +
          (r.m.price != null ? '<span class="wf-price-tag">€ ' + esc(r.m.price) + "</span>" : "") +
          "</div>" +
          '<div class="wf-card-name no-tx">' + esc(w.name) + (w.vintage ? " " + esc(w.vintage) : "") + "</div>" +
          '<div class="wf-card-prod no-tx">' + esc(w.producer) + "</div>" +
          (meta ? '<div class="wf-card-meta">' + meta + "</div>" : "") +
          (reason ? '<div class="wf-card-why">' + esc(reason) + "</div>" : "") +
          '<button type="button" class="wf-show" data-name="' + esc(w.name) + '" data-producer="' + esc(w.producer) + '">Vedi sulla mappa →</button>' +
          "</article>"
        );
      }

      function wireActions() {
        Array.prototype.forEach.call(elResults.querySelectorAll(".wf-show"), function (btn) {
          btn.onclick = function () {
            window.dispatchEvent(
              new CustomEvent("winefinder:show", {
                detail: { name: btn.getAttribute("data-name"), producer: btn.getAttribute("data-producer") },
              })
            );
          };
        });
        Array.prototype.forEach.call(elResults.querySelectorAll(".wf-sheet"), function (btn) {
          btn.onclick = function () {
            window.dispatchEvent(
              new CustomEvent("winefinder:sheet", {
                detail: { name: btn.getAttribute("data-name"), producer: btn.getAttribute("data-producer") },
              })
            );
          };
        });
      }

      function render() {
        var expanded = sel.q ? expandQuery(sel.q) : [];
        var rows = [];
        META.forEach(function (m) {
          if (!passesFacets(m)) return;
          var kw = keywordScore(expanded, m);
          var sm = semScoreFor(m);
          var facetBonus =
            (Object.keys(sel.type).length ? 0.12 : 0) +
            (sel.region ? 0.08 : 0) +
            (Object.keys(sel.occ).length ? 0.12 : 0);
          var score;
          if (sel.q) {
            score = (sm != null ? 0.62 * sm + 0.16 * kw : 0.55 * kw) + 0.2 * (m.rating / 5) + facetBonus;
          } else {
            score = 0.8 * (m.rating / 5) + facetBonus;
          }
          rows.push({ m: m, score: score, kw: kw, sm: sm });
        });
        rows.sort(function (a, b) { return b.score - a.score || b.m.rating - a.m.rating; });

        updateBoostVisibility();

        if (!rows.length) {
          elResults.innerHTML =
            '<p class="wf-empty">Nessun vino con questi criteri. Allarga il prezzo o togli un filtro.</p>';
          return;
        }

        var primary = rows[0];
        var rest = rows.slice(1, 6);
        var best = primary.score || 1;
        var html = '<h3 class="wf-h">La mia scelta</h3>' + primaryCardHtml(primary);
        if (rest.length) {
          html +=
            '<h3 class="wf-h">Altre buone scelte</h3><div class="wf-more-grid">' +
            rest
              .map(function (r) {
                var strength = Math.max(0, Math.min(1, r.score / best));
                return compactCardHtml(r, strength);
              })
              .join("") +
            "</div>";
        }
        elResults.innerHTML = html;
        wireActions();

        if (window.WineI18n && window.WineI18n.lang === "en") window.WineI18n.translate(elResults);
      }

      function run() {
        if (sel.q && SEM.ready) ensureQueryVector(render);
        else render();
      }

      if (window.WineI18n) window.WineI18n.onChange(function () { render(); });

      run();
    });
  })();
</script>
