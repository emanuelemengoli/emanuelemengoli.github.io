#!/usr/bin/env ruby
# frozen_string_literal: true

# Auto-compile races (trail, ultra, triathlon, road, skyrun) into _data/races.yml (merge /
# upsert), from every adapter under bin/race_sources/. Sources are deliberately narrow for
# now (see the SOURCES list below) — France- and Italy-focused federations plus a couple
# of international trail/triathlon brand calendars; other countries are documented stubs,
# not silently missing. No manual data entry — this is meant to run unattended on a
# schedule (.github/workflows/sync-races.yml, monthly) which opens a pull request with the
# result; merging that PR is the owner's only manual step. Setup / source list:
# bin/races-sync.md.
#
# Usage:
#   ruby bin/sync-races                  fetch every source, merge into _data/races.yml
#   ruby bin/sync-races --source=ffa,utmb    run only the named source(s) (debugging)
#   ruby bin/sync-races --sort           also re-order soonest-first
#   ruby bin/sync-races --commit         also `git commit` the result (local convenience;
#                                        the scheduled workflow opens a PR instead)
#   ruby bin/sync-races --dry-run        show what would change, write nothing

require "yaml"
require "date"

require_relative "lib/http"
require_relative "lib/text"
require_relative "lib/geocode"
require_relative "race_sources/base"
require_relative "race_sources/ffa"
require_relative "race_sources/fitri"
require_relative "race_sources/skyrunning_it"
require_relative "race_sources/utmb"

ROOT       = File.expand_path("..", __dir__)
RACES_YML  = File.join(ROOT, "_data", "races.yml")
CACHE_FILE = File.join(ROOT, "bin", ".races_geocache.json")

PRUNE_HORIZON_DAYS = 7 # a race more than this many days in the past is dropped, not kept forever

# Deliberately narrow "for now," per the owner: only the named national federations, the
# trail/skyrunning-specific sources, and the international brand calendars explicitly
# asked for — not the broader AIMS/DUV/Spain/Switzerland/Austria breadth from the first
# pass at this (that code still exists in git history if it's wanted back later; aims.rb
# and duv.rb are still on disk, just not required/listed below).
SOURCES = [
  RaceSources::Ffa.new,
  # fftri.com's national-championship-stages table turned out to be poor-quality for
  # this purpose on inspection: much of its date content is stale (2018 in the mix
  # alongside a little 2026), dates are given without a year per row, and a Google-
  # Sheets-pasted table structure with merged header cells across "stages" of one
  # championship — scraping it as-is risks silently attaching the wrong year to a race
  # rather than just missing it. Left a stub rather than ship wrong dates.
  RaceSources::Stub.new("fftri", note: "France triathlon — fftri.com's calendar page is a stale, " \
                                        "undated Google-Sheets export (see bin/race_sources comment " \
                                        "history) — not reliably scrapable as-is"),
  # fidal.it's calendar.php accepts a livello/regione/anno query like athle.fr's, but the
  # actual parameter values it expects aren't documented anywhere discoverable and guesses
  # (livello=NAZ etc.) return the empty search form, not results; the regional pages
  # elsewhere on the site are PDF-only. Left a stub rather than guess further.
  RaceSources::Stub.new("fidal", note: "Italy athletics (road + trail) — fidal.it's calendar.php is " \
                                        "a filtered search form whose real parameter values aren't " \
                                        "documented (guesses return an empty form); its regional " \
                                        "pages are PDF-only"),
  RaceSources::Fitri.new,
  RaceSources::SkyrunningIt.new,
  RaceSources::Utmb.new,
  # Checked directly: itra.run/Races/RaceCalendar loads its results via client-side JS
  # (empty on initial load) and the site sits behind a bot-challenging AWS WAF that
  # started returning empty 202 "challenge" responses after a few plain requests — not a
  # plain-HTTP-scrapable source. See bin/race_sources/utmb.rb's header comment for why
  # UTMB's own World Series list was used instead for trail coverage.
  RaceSources::Stub.new("itra", note: "itra.run's calendar loads via client-side JS and sits behind " \
                                       "a bot-challenging WAF — not scrapable via plain HTTP"),
  # www.ironman.com is behind a Cloudflare bot challenge (blocks plain requests outright);
  # the bare ironman.com domain isn't challenged the same way and does serve a real
  # /races page, but the actual listing renders via a Drupal AJAX call (same pattern as
  # Spain's RFEA calendar, not cracked there either) rather than being present in the
  # plain HTML response.
  RaceSources::Stub.new("ironman", note: "ironman.com's race listing is Drupal-AJAX-gated " \
                                          "(www.ironman.com is Cloudflare-blocked outright); " \
                                          "neither path is a plain HTTP scrape"),
  # Spain (RFEA/RFETRI), Switzerland (Swiss Athletics/Swiss Triathlon) and Austria (ÖLV/
  # Austria Triathlon) are out of scope for now, per the owner — this file previously had
  # working scrapers for Switzerland and Austria; removed rather than left unused. If
  # these come back into scope, RFEA/RFETRI's Drupal-AJAX / Blazor-SPA blockers apply the
  # same way Spain's do below and would need solving first.
  RaceSources::Stub.new("spain", note: "not in scope for now — RFEA's calendar is AJAX-gated " \
                                        "(Drupal) and RFETRI's is a Blazor SPA; to be identified " \
                                        "and added if/when this country comes back into scope"),
  RaceSources::Stub.new("switzerland", note: "not in scope for now — federation sources to be " \
                                              "identified and added if/when this country comes " \
                                              "back into scope"),
  RaceSources::Stub.new("austria", note: "not in scope for now — federation sources to be " \
                                          "identified and added if/when this country comes back " \
                                          "into scope")
].freeze

TOP_ORDER = %w[name date category country region distance_km distances_km elevation_gain_m
               difficulty lat lng price organizer url notes series source source_url last_synced].freeze

options = { sort: false, commit: false, dry_run: false, sources: nil }
ARGV.each do |a|
  case a
  when "--sort"          then options[:sort] = true
  when "--commit"        then options[:commit] = true
  when "--dry-run", "-n" then options[:dry_run] = true
  when /\A--source=(.+)\z/ then options[:sources] = Regexp.last_match(1).split(",").map(&:strip)
  when "-h", "--help"
    puts <<~USAGE
      Auto-compile races into _data/races.yml (merge / upsert) from bin/race_sources/.
      Setup: bin/races-sync.md

        ruby bin/sync-races                   fetch every source
        ruby bin/sync-races --source=aims,duv run only the named source(s)
        ruby bin/sync-races --sort            also re-order soonest-first
        ruby bin/sync-races --commit          also `git commit` the result
        ruby bin/sync-races --dry-run         show what would change, write nothing
    USAGE
    exit 0
  else
    abort "unknown option: #{a}"
  end
end

# --------------------------------------------------------------------------- utils

def entry_key(entry)
  [Text.norm(entry["name"]), entry["date"].to_s.strip, Text.norm(entry["country"])].join("|")
end

def deep_merge!(dst, src)
  src.each do |k, v|
    if v.is_a?(Hash) && dst[k].is_a?(Hash)
      deep_merge!(dst[k], v)
    else
      dst[k] = v
    end
  end
  dst
end

def canonicalize(entry)
  out = {}
  TOP_ORDER.each { |k| out[k] = entry[k] unless Text.blank?(entry[k]) }
  (entry.keys - TOP_ORDER).each { |k| out[k] = entry[k] unless Text.blank?(entry[k]) }
  out
end

REQUIRED = %w[name date category source source_url].freeze

def valid?(entry)
  REQUIRED.all? { |f| !Text.blank?(entry[f]) }
end

# --------------------------------------------------------------------------- fetch

today  = Date.today
cutoff = today - PRUNE_HORIZON_DAYS

active_sources = options[:sources] ? SOURCES.select { |s| options[:sources].include?(s.name) } : SOURCES
if options[:sources]
  unknown = options[:sources] - SOURCES.map(&:name)
  abort "unknown --source: #{unknown.join(', ')} (known: #{SOURCES.map(&:name).join(', ')})" unless unknown.empty?
end

incoming = []
skipped_invalid = 0
per_source = {}

active_sources.each do |source|
  warn "Fetching #{source.name}…"
  fetched =
    begin
      source.fetch
    rescue StandardError => e
      # Belt-and-braces on top of each adapter's own rescue: nothing a source does should
      # ever be able to take the rest of the run down with it.
      warn "  ! #{source.name}: unexpected #{e.class}: #{e.message} — skipping this source"
      []
    end
  kept = fetched.select do |e|
    ok = valid?(e)
    skipped_invalid += 1 unless ok
    ok
  end
  per_source[source.name] = kept.size
  incoming.concat(kept)
end

# --------------------------------------------------------------------------- load YAML

raw_yaml = File.exist?(RACES_YML) ? File.read(RACES_YML) : ""
lines = raw_yaml.lines
hdr_end = 0
lines.each_with_index do |ln, i|
  (ln.strip.empty? || ln.lstrip.start_with?("#")) ? (hdr_end = i + 1) : break
end
header = lines[0...hdr_end].join.rstrip
body   = lines[hdr_end..].to_a.join

existing = body.strip.empty? ? [] : YAML.safe_load(body, permitted_classes: [Date], aliases: false)
existing = [] unless existing.is_a?(Array)
existing.each { |e| e["date"] = e["date"].strftime("%Y-%m-%d") if e["date"].is_a?(Date) }
by_key = existing.each_with_object({}) { |e, h| h[entry_key(e)] = e }

# --------------------------------------------------------------------------- merge

geocoder = Geocode::Client.new(CACHE_FILE)
added = updated = 0

incoming.each do |inc|
  inc["last_synced"] = today.strftime("%Y-%m-%d")
  key = entry_key(inc)
  cur = by_key[key]

  if cur
    before = Marshal.load(Marshal.dump(cur))
    deep_merge!(cur, inc)
    if Text.blank?(cur["lat"]) || Text.blank?(cur["lng"])
      coords = geocoder.lookup(cur["name"], cur["region"], cur["country"])
      cur["lat"], cur["lng"] = coords if coords
    end
    cur.replace(canonicalize(cur))
    updated += 1 unless cur == before
  else
    coords = geocoder.lookup(inc["name"], inc["region"], inc["country"])
    inc["lat"], inc["lng"] = coords if coords

    entry = canonicalize(inc)
    existing << entry
    by_key[key] = entry
    added += 1
  end
end

# --------------------------------------------------------------------------- prune

before_prune = existing.size
# Only a currently-*real* adapter counts as "known" — a Stub (whether it was never built
# or was downgraded from a real adapter after a scope change) will never refresh an
# entry again, so its old data is exactly as stale as one from a source removed outright.
# Computed from the full SOURCES list, not --source=-filtered, so a one-off debug run of
# a single adapter can never orphan every other real source's entries.
known_sources = SOURCES.reject { |s| s.is_a?(RaceSources::Stub) }.map(&:name)
existing.reject! do |e|
  d = e["date"]
  expired = !Text.blank?(d) && (Date.parse(d) < cutoff rescue false)
  orphaned = !known_sources.include?(e["source"])
  expired || orphaned
end
pruned = before_prune - existing.size

if options[:sort]
  existing.sort! do |a, b|
    cmp = a["date"].to_s <=> b["date"].to_s
    cmp.zero? ? a["name"].to_s.casecmp(b["name"].to_s) : cmp
  end
end

# --------------------------------------------------------------------------- write

new_body = Psych.dump(existing, line_width: -1).sub(/\A---\n/, "")
new_body = new_body.gsub(/(\n)(- name:)/, "\\1\n\\2") # blank line between entries
new_file = "#{header}\n\n#{new_body}"

per_source_summary = per_source.map { |n, c| "#{n}=#{c}" }.join(" ")
summary = "#{existing.size} races · #{added} added · #{updated} updated · #{pruned} pruned · " \
          "#{geocoder.lookups} geocoded · #{skipped_invalid} skipped (invalid) · [#{per_source_summary}]"

if options[:dry_run]
  warn "[dry-run] #{summary}"
  warn "[dry-run] #{new_file == raw_yaml ? 'no change to' : 'would rewrite'} _data/races.yml"
else
  changed = new_file != raw_yaml
  File.write(RACES_YML, new_file) if changed
  geocoder.save
  warn summary
  if changed
    warn "Wrote _data/races.yml"
    if options[:commit]
      system("git", "-C", ROOT, "add", "_data/races.yml") &&
        system("git", "-C", ROOT, "commit", "-m", "races: monthly sync")
    else
      warn "Review with:  git diff _data/races.yml    then commit & push (or let the scheduled workflow open a PR)."
    end
  else
    warn "_data/races.yml already up to date."
  end
end
