#!/usr/bin/env ruby
# frozen_string_literal: true

# Sync "Scheda di degustazione del vino" Google-Form responses into _data/wines.yml
# (merge / upsert). Handles both the "Corta" and "Completa" paths and the per-tipologia
# branches, which produce many duplicately-named CSV columns.
#
# The form is generated by bin/analisi_vino/wine_tasting_form_generator.gs
# (plain-text description: bin/analisi_vino/form_model.txt). Setup: bin/wines-sync.md.
#
# Usage:
#   WINES_CSV_URL="https://docs.google.com/.../pub?output=csv" ruby bin/sync-wines
#   ruby bin/sync-wines --sort       also re-order newest-tasted first
#   ruby bin/sync-wines --commit     also `git commit` the result
#   ruby bin/sync-wines --dry-run    show what would change, write nothing
#   WINES_DATE_ORDER=dmy ...         read ambiguous d/m/y dates as day-first

require "csv"
require "json"
require "yaml"
require "date"
require "net/http"
require "uri"

ROOT       = File.expand_path("..", __dir__)
WINES_YML  = File.join(ROOT, "_data", "wines.yml")
CACHE_FILE = File.join(ROOT, "bin", ".wines_geocache.json")
URL_FILE   = File.join(ROOT, "bin", "wines_csv_url.txt")

USER_AGENT = "emanuelemengoli.github.io wine-map sync " \
             "(+https://github.com/emanuelemengoli/emanuelemengoli.github.io)"

# Exact form question titles (normalised: accent-folded, lower-cased, non-alphanumerics
# removed) -> entry path + kind. A field may map to SEVERAL columns because the form
# repeats questions per tipologia / per Corta|Completa path; a respondent fills only one,
# so scalar fields take the first non-blank column and :list fields merge them.
# Kinds: :text :int :rating :date :num :price :list :url. Paths starting "_" are transient.
FIELDS = [
  ["producer",                          :text,  %w[cantinaproduttore]],
  ["name",                              :text,  %w[nomedelvino]],
  ["denominazione",                     :text,  %w[denominazione]],
  ["territorio",                        :text,  %w[territoriodiproduzione]],
  ["grape",                             :text,  %w[vitignoi vitigno vitigni]],
  ["vintage",                           :int,   %w[annata]],
  ["tasted",                            :date,  %w[data]],
  ["price",                             :price, %w[prezzo]],
  ["region",                            :text,  %w[regione]],
  ["country",                           :text,  %w[stato]],
  ["url",                               :url,   %w[url sito sitoweb]],
  ["_lat",                              :num,   %w[latitudine]],
  ["_lng",                              :num,   %w[longitudine]],
  ["_tipologia",                        :text,  %w[tipologia]],

  ["tasting.visual.metodo",             :text,  %w[metododiproduzione]],
  ["_metodo_altro",                     :text,  %w[metododiproduzionealtro]],
  ["tasting.visual.limpidezza",         :text,  %w[limpidezza]],
  ["tasting.visual.intensita_colore",   :text,  %w[intensitadelcolore]],
  ["tasting.visual.colore",             :text,  %w[colore]],
  ["tasting.visual.osservazioni",       :list,  %w[altreosservazionivisive]],
  ["tasting.visual.effervescenza",      :text,  %w[effervescenzaintensita]],
  ["tasting.visual.perlage_dimensione", :text,  %w[perlagedimensionedellebollicine]],
  ["tasting.visual.perlage_persistenza", :text, %w[perlagepersistenza]],

  ["tasting.nose.condizione",           :text,  %w[condizionedeisentori]],
  ["tasting.nose.intensita",            :text,  %w[intensita]],
  ["tasting.nose.evoluzione",           :text,  %w[evoluzioneolfattiva]],
  ["tasting.nose.altri_aromi",          :text,  %w[altriarominoteolfattive altroaroma]],

  ["tasting.palate.zucchero",           :text,  %w[zucchero]],
  ["tasting.palate.acidita",            :text,  %w[acidita]],
  ["tasting.palate.tannini",            :text,  %w[tannini]],
  ["tasting.palate.alcol",              :text,  %w[alcol]],
  ["tasting.palate.corpo",              :text,  %w[corpo]],
  ["tasting.palate.intensita_sapori",   :text,  %w[intensitadeisapori]],
  ["tasting.palate.finale",             :text,  %w[persistenzafinale]],
  ["tasting.palate.aromi_palato",       :list,  %w[caratteristichedegliaromialpalato]],

  ["notes",                             :text,   %w[lemieimpressioni letueimpressioni]],
  ["pairing",                           :text,   %w[unpiattodiaccompagnamento]],
  ["rating",                            :rating, %w[valutazionecomplessiva]]
].freeze

# Every aroma checkbox question — the Corta macro-categories, the Completa families, the
# defect groups and the fruit-evolution groups. Values from all of them merge into
# tasting.nose.aromi; a trailing "(examples …)" is stripped from the macro-category labels.
AROMA_TITLES = %w[
  florealefruttato speziatovegetale altri aromisecondari aromiterziari
  floreale fruttiverdi agrumi frutticonnocciolo fruttiesotici fruttirossi fruttineri
  fruttisecchicotti linfa vegetale erbespontanee speziedolci spezieforti balsamici
  minerali marini nobili possibilidifetti riduzione difetti lievitifecceautolisi
  prodotticaseari tostati ossidazionedeliberata
  evoluzionedellenotefruttateneivinirossi evoluzionedellenotefruttateneivinibianchi
].freeze

TOP_ORDER = %w[name producer url denominazione territorio region country lat lng
               vintage grape price color sparkling rating tasted notes pairing tasting].freeze
SECTION_ORDER = {
  "visual" => %w[limpidezza intensita_colore colore osservazioni metodo effervescenza
                 perlage_dimensione perlage_persistenza],
  "nose"   => %w[condizione intensita evoluzione aromi altri_aromi],
  "palate" => %w[zucchero acidita tannini alcol corpo intensita_sapori aromi_palato finale]
}.freeze

TIPOLOGIA_COLOR = {
  "rosso" => "red", "red" => "red",
  "bianco" => "white", "white" => "white",
  "rose" => "rosé", "rosato" => "rosé",
  "spumante" => "sparkling", "sparkling" => "sparkling", "frizzante" => "sparkling",
  "arancione" => "orange", "orange" => "orange", "ambrato" => "orange"
}.freeze

options = { sort: false, commit: false, dry_run: false }
ARGV.each do |a|
  case a
  when "--sort"          then options[:sort] = true
  when "--commit"        then options[:commit] = true
  when "--dry-run", "-n" then options[:dry_run] = true
  when "-h", "--help"
    puts <<~USAGE
      Sync "Scheda di degustazione del vino" form responses into _data/wines.yml (merge / upsert).
      Setup: bin/wines-sync.md

        WINES_CSV_URL="https://docs.google.com/.../pub?output=csv" ruby bin/sync-wines
        ruby bin/sync-wines --sort      also re-order newest-tasted first
        ruby bin/sync-wines --commit    also `git commit` the result
        ruby bin/sync-wines --dry-run   show what would change, write nothing
    USAGE
    exit 0
  else
    abort "unknown option: #{a}"
  end
end

# --------------------------------------------------------------------------- utils

def utf8(str)
  s = str.to_s
  s = s.dup.force_encoding(Encoding::UTF_8) unless s.encoding == Encoding::UTF_8
  s.valid_encoding? ? s : s.scrub
end

def norm(str)
  utf8(str).unicode_normalize(:nfkd).gsub(/\p{Mn}/, "").downcase.gsub(/[^a-z0-9]+/, " ").strip
end

def key_norm(str)
  norm(str).delete(" ")
end

def blank?(val)
  return true if val.nil?
  return val.strip.empty? if val.is_a?(String)
  return val.empty? if val.is_a?(Array) || val.is_a?(Hash)
  false
end

# Split a Google-Forms checkbox cell on ", " that is NOT inside parentheses, then drop a
# trailing "(a, b, c)" (the examples appended to Corta macro-category labels).
def split_multi(val)
  s = utf8(val).strip
  return [] if s.empty?
  s.split(/,\s+(?![^(]*\))/)
   .map { |x| x.sub(/\s*\([^)]*\)\s*\z/, "").strip }
   .reject(&:empty?)
end

def dig_set(hash, path, value)
  keys = path.split(".")
  last = keys.pop
  node = keys.reduce(hash) { |h, k| h[k] ||= {} }
  node[last] = value
end

def entry_key(entry)
  [norm(entry["producer"]), norm(entry["name"]), entry["vintage"].to_s.strip].join(" ")
end

def to_yaml_date(val)
  return nil if blank?(val)
  s = val.to_s.strip
  return s[0, 10] if s.match?(/\A\d{4}-\d{2}-\d{2}/)
  if (m = s.match(%r{\A(\d{1,2})[/.](\d{1,2})[/.](\d{4})}))
    a, b, y = m[1].to_i, m[2].to_i, m[3].to_i
    order = ENV["WINES_DATE_ORDER"].to_s.downcase
    mo, d =
      if    a > 12 && b <= 12 then [b, a]
      elsif b > 12 && a <= 12 then [a, b]
      elsif order == "dmy"    then [b, a]
      else
        warn "  ~ ambiguous date #{s.inspect}, read month/day; set WINES_DATE_ORDER=dmy if wrong" if order.empty?
        [a, b]
      end
    return Date.new(y, mo, d).strftime("%Y-%m-%d")
  end
  Date.parse(s).strftime("%Y-%m-%d")
rescue ArgumentError
  warn "  ! could not parse date #{val.inspect} — leaving 'tasted' blank"
  nil
end

def to_rating(val)
  return nil if blank?(val)
  return nil unless (m = val.to_s.match(/\d+(?:[.,]\d+)?/))
  r = m[0].tr(",", ".").to_f.clamp(0.0, 5.0)
  x = (r * 2).round / 2.0
  x == x.to_i ? x.to_i : x
end

def to_vintage(val)
  return nil if blank?(val)
  m = val.to_s.match(/\b(1[89]\d{2}|20\d{2})\b/)
  m && m[1].to_i
end

def to_num(val, lo, hi)
  return nil if blank?(val)
  m = val.to_s.tr(",", ".").match(/-?\d+(?:\.\d+)?/)
  return nil unless m
  n = m[0].to_f
  n.between?(lo, hi) ? n.round(6) : nil
end

def coerce(kind, raw)
  case kind
  when :text   then blank?(raw) ? nil : utf8(raw).strip
  when :int    then to_vintage(raw)
  when :rating then to_rating(raw)
  when :date   then to_yaml_date(raw)
  when :price  then blank?(raw) ? nil : "€ #{utf8(raw).strip.sub(/\A€\s*/, '')}"
  when :list   then blank?(raw) ? nil : split_multi(raw)
  when :url    then to_url(raw)
  end
end

# The form's optional "Url" field: accept a full URL, or add https:// to a bare
# host like "gdvajra.it"; reject anything that isn't host-shaped.
def to_url(raw)
  return nil if blank?(raw)
  s = utf8(raw).strip.gsub(/\s+/, "")
  return s if s.match?(%r{\Ahttps?://}i)
  s.match?(%r{\A[\w-]+(\.[\w-]+)+([/?#].*)?\z}) ? "https://#{s}" : nil
end

def derive_color(entry, tipologia)
  t = key_norm(tipologia)
  return TIPOLOGIA_COLOR[t] if TIPOLOGIA_COLOR.key?(t)
  col = norm(entry.dig("tasting", "visual", "colore"))
  return "orange" if col.match?(/ambrat|arancion|amber/)
  return "white"  if col.match?(/giall|paglierino|verdolino|dorato/)
  return "rosé"   if col.match?(/rosa|cerasuolo|salmone|chiaretto|corallo/)
  return "red"    if col.match?(/rosso|granato|rubino|bordeaux|porpora|violaceo|mattone|\bnero\b/)
  nil
end

def canonicalize(entry)
  out = {}
  TOP_ORDER.each { |k| out[k] = entry[k] unless k == "tasting" || blank?(entry[k]) }
  tasting = entry["tasting"]
  if tasting.is_a?(Hash)
    sections = {}
    SECTION_ORDER.each do |sec, order|
      src = tasting[sec]
      next unless src.is_a?(Hash)
      dst = {}
      (order | src.keys).each { |k| dst[k] = src[k] unless blank?(src[k]) }
      sections[sec] = dst unless dst.empty?
    end
    out["tasting"] = sections unless sections.empty?
  end
  out
end

def deep_merge!(dst, src)
  src.each do |k, v|
    if v.is_a?(Hash) && dst[k].is_a?(Hash)
      deep_merge!(dst[k], v)
    else
      dst[k] = v
    end
  end
  dst
end

def http_get(url, limit = 5)
  raise "too many redirects" if limit <= 0
  uri = URI(url)
  req = Net::HTTP::Get.new(uri)
  req["User-Agent"] = USER_AGENT
  res = Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == "https",
                        open_timeout: 15, read_timeout: 30) { |http| http.request(req) }
  case res
  when Net::HTTPSuccess     then res.body
  when Net::HTTPRedirection then http_get(res["location"], limit - 1)
  else raise "HTTP #{res.code} for #{url}"
  end
end

# --------------------------------------------------------------------------- geocode

CACHE = File.exist?(CACHE_FILE) ? ((JSON.parse(File.read(CACHE_FILE)) rescue {})) : {}
$geocoded_this_run = 0

def geocode(*parts)
  query = parts.map { |p| p.to_s.strip }.reject(&:empty?).join(", ")
  return nil if query.empty?
  return CACHE[query] if CACHE.key?(query)

  result = nominatim(query)
  if result.nil? && parts.length > 1
    fallback = parts.drop(1).map { |p| p.to_s.strip }.reject(&:empty?).join(", ")
    result = nominatim(fallback) unless fallback.empty? || fallback == query
  end
  CACHE[query] = result
  result
end

def nominatim(query)
  uri = URI("https://nominatim.openstreetmap.org/search")
  uri.query = URI.encode_www_form(q: query, format: "json", limit: 1, addressdetails: 0)
  body = http_get(uri.to_s)
  sleep 1 # Nominatim usage policy: <= 1 request/second
  $geocoded_this_run += 1
  hit = JSON.parse(body).first
  hit && [hit["lat"].to_f.round(6), hit["lon"].to_f.round(6)]
rescue StandardError => e
  warn "  ! geocode failed for #{query.inspect}: #{e.class}: #{e.message}"
  nil
end

# --------------------------------------------------------------------------- load CSV

csv_url = ENV["WINES_CSV_URL"]
csv_url = File.read(URL_FILE).strip if (csv_url.nil? || csv_url.empty?) && File.exist?(URL_FILE)
abort "No CSV URL. Set WINES_CSV_URL or create #{URL_FILE} (see bin/wines-sync.md)." if csv_url.nil? || csv_url.empty?

warn "Fetching form responses…"
csv_text = utf8(http_get(csv_url)).sub(/\A\uFEFF/, "")
rows = CSV.parse(csv_text)
abort "The CSV is empty." if rows.empty?
head = rows.shift.map { |h| key_norm(h) } # normalised header, by column index

# field -> [column indices]  (index-based: the form has many duplicate header names)
idx_for = {}
FIELDS.each do |path, kind, titles|
  cols = head.each_index.select { |i| titles.include?(head[i]) }
  idx_for[[path, kind]] = cols unless cols.empty?
end
used = idx_for.values.flatten
%w[producer name].each do |req|
  abort "No CSV column for '#{req}'. Headers: #{head.inspect}" unless idx_for.keys.any? { |(p, _)| p == req }
end
aroma_idx = head.each_index.select { |i| AROMA_TITLES.include?(head[i]) && !used.include?(i) }
warn "Mapped #{idx_for.size} fields across #{used.size} columns + #{aroma_idx.size} aroma columns"

def cell(row, indices)
  indices.map { |i| row[i] }.find { |v| !blank?(v) }
end

incoming = {}
skipped = 0
rows.each_with_index do |row, ri|
  next if row.all? { |v| blank?(v) }
  entry = {}
  tipologia = lat = lng = metodo_altro = nil

  idx_for.each do |(path, kind), cols|
    if kind == :list
      vals = cols.flat_map { |i| split_multi(row[i]) }.uniq
      dig_set(entry, path, vals) unless vals.empty?
      next
    end
    raw = cell(row, cols)
    next if blank?(raw)
    case path
    when "_lat"          then lat = to_num(raw, -90, 90)
    when "_lng"          then lng = to_num(raw, -180, 180)
    when "_tipologia"    then tipologia = raw.to_s.strip
    when "_metodo_altro" then metodo_altro = raw.to_s.strip
    else
      v = coerce(kind, raw)
      dig_set(entry, path, v) unless v.nil?
    end
  end

  aromas = aroma_idx.flat_map { |i| split_multi(row[i]) }.uniq
  dig_set(entry, "tasting.nose.aromi", aromas) unless aromas.empty?

  if blank?(entry["name"]) || blank?(entry["producer"])
    warn "  ! row #{ri + 2}: missing nome/produttore — skipped"
    skipped += 1
    next
  end

  m = entry.dig("tasting", "visual", "metodo")
  if !blank?(metodo_altro) && (blank?(m) || norm(m) == "altro")
    dig_set(entry, "tasting.visual.metodo", metodo_altro)
  end
  if (mc = derive_color(entry, tipologia))
    entry["color"] = mc
    entry["sparkling"] = true if mc == "sparkling"
  end
  entry["_override"] = [lat, lng] if lat && lng

  incoming[entry_key(entry)] = entry
end

# --------------------------------------------------------------------------- load YAML

raw_yaml = File.exist?(WINES_YML) ? File.read(WINES_YML) : ""
lines = raw_yaml.lines
hdr_end = 0
lines.each_with_index do |ln, i|
  (ln.strip.empty? || ln.lstrip.start_with?("#")) ? (hdr_end = i + 1) : break
end
header = lines[0...hdr_end].join.rstrip
body   = lines[hdr_end..].to_a.join

existing = body.strip.empty? ? [] : YAML.safe_load(body, permitted_classes: [Date], aliases: false)
existing = [] unless existing.is_a?(Array)
existing.each { |e| e["tasted"] = e["tasted"].strftime("%Y-%m-%d") if e["tasted"].is_a?(Date) }
by_key = existing.each_with_object({}) { |e, h| h[entry_key(e)] = e }

producer_coords = {}
existing.each do |e|
  k = norm(e["producer"])
  next if producer_coords.key?(k)
  lat = Float(e["lat"], exception: false)
  lng = Float(e["lng"], exception: false)
  producer_coords[k] = [lat, lng] if lat && lng
end

# --------------------------------------------------------------------------- merge

added = updated = 0

incoming.each_value do |inc|
  key = entry_key(inc)
  override = inc.delete("_override")
  cur = by_key[key]

  if cur
    before = Marshal.load(Marshal.dump(cur))
    deep_merge!(cur, inc)

    # A re-submission never silently moves a pin: only an explicit override, or a
    # first-time lookup for an entry that has no coordinates yet.
    if override
      cur["lat"], cur["lng"] = override
    elsif blank?(cur["lat"]) || blank?(cur["lng"])
      if (coords = geocode(cur["producer"], cur["region"], cur["country"]))
        cur["lat"], cur["lng"] = coords
      end
    end

    cur.replace(canonicalize(cur))
    updated += 1 unless cur == before
  else
    if override
      inc["lat"], inc["lng"] = override
    elsif (coords = producer_coords[norm(inc["producer"])])
      inc["lat"], inc["lng"] = coords
    elsif (coords = geocode(inc["producer"], inc["region"], inc["country"]))
      inc["lat"], inc["lng"] = coords
    end
    warn "  ! #{inc['producer']} — #{inc['name']}: no coordinates (won't appear on the map)" if blank?(inc["lat"])

    entry = canonicalize(inc)
    existing << entry
    by_key[key] = entry
    added += 1
  end
end

if options[:sort]
  existing.sort! do |a, b|
    cmp = b["tasted"].to_s <=> a["tasted"].to_s
    cmp.zero? ? a["name"].to_s.casecmp(b["name"].to_s) : cmp
  end
end

# --------------------------------------------------------------------------- write

new_body = Psych.dump(existing, line_width: -1).sub(/\A---\n/, "")
new_body = new_body.gsub(/(\n)(- name:)/, "\\1\n\\2") # blank line between entries
new_file = "#{header}\n\n#{new_body}"

summary = "#{existing.size} wines · #{added} added · #{updated} updated · " \
          "#{$geocoded_this_run} geocoded · #{skipped} skipped"

if options[:dry_run]
  warn "[dry-run] #{summary}"
  warn "[dry-run] #{new_file == raw_yaml ? 'no change to' : 'would rewrite'} _data/wines.yml"
else
  changed = new_file != raw_yaml
  File.write(WINES_YML, new_file) if changed
  File.write(CACHE_FILE, JSON.pretty_generate(CACHE) + "\n")
  warn summary
  if changed
    warn "Wrote _data/wines.yml"
    if options[:commit]
      system("git", "-C", ROOT, "add", "_data/wines.yml") &&
        system("git", "-C", ROOT, "commit", "-m", "wines: sync from tasting form")
    else
      warn "Review with:  git diff _data/wines.yml    then commit & push."
    end
  else
    warn "_data/wines.yml already up to date."
  end
end
